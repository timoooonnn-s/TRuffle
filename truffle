               "yellow": curses.COLOR_YELLOW, "blue": curses.COLOR_BLUE, "cyan": curses.COLOR_CYAN,
               "white": curses.COLOR_WHITE}


class Theme(object):
    """Every PALETTE name becomes an attribute holding a ready-to-use curses attribute."""

    def __init__(self, charset):
        self.sym = CHARSETS[charset]
        self.colors = 0
        for name in PALETTE:
            setattr(self, name, self._flags(MONO.get(name, "")))
        try:
            if not curses.has_colors():
                return
            try:
                curses.use_default_colors()
                default = -1
            except curses.error:
                default = None
            rich = curses.COLORS >= 256 and curses.COLOR_PAIRS > len(PALETTE)
            for number, (name, specs) in enumerate(PALETTE.items(), 1):
                fg, bg, flags = specs[0] if rich else specs[1]
                fg, bg = COLOR_NAMES.get(fg, fg), COLOR_NAMES.get(bg, bg)
                if default is None:
                    fg = curses.COLOR_WHITE if fg == -1 else fg
                    bg = curses.COLOR_BLACK if bg == -1 else bg
                curses.init_pair(number, fg, bg)
                setattr(self, name, curses.color_pair(number) | self._flags(flags))
            self.colors = 256 if rich else 8
        except curses.error:
            pass

    @staticmethod
    def _flags(flags):
        value = 0
        for f in flags:
            value |= {"b": curses.A_BOLD, "d": curses.A_DIM, "u": curses.A_UNDERLINE, "r": curses.A_REVERSE}[f]
        return value


