CONTROL_CHARS = re.compile(r"[\x00-\x1f\x7f]")


def clean(value):
    return CONTROL_CHARS.sub(" ", value or "").strip()


def read_text(path):
    try:
        with open(path, "rb") as f:
            raw = f.read()
    except OSError as e:
        raise DataError("cannot read %s: %s" % (path, e.strerror or e))
    # UTF-8 (with or without BOM) first, then what Excel on Windows writes.
    for encoding in ("utf-8-sig", "cp1252"):
        try:
            return raw.decode(encoding)
        except UnicodeDecodeError:
            pass
    return raw.decode("latin-1")


def detect_delimiter(header_line):
    best, count = ";", 0
    for d in (";", ",", "\t", "|"):
        c = header_line.count(d)
        if c > count:
            best, count = d, c
    return best


def read_table(path, report=None):
    """Return (headers, rows); every row is a dict header -> cleaned value.  The
    delimiter is detected from the header line.  Blank lines and lines starting with
    '#' are ignored.  If report is a dict it receives the delimiter used, the CSV
    line of every row and field-count problems."""
    if not os.path.isfile(path):
        hint = ""
        if os.path.isfile(os.path.join(SCRIPT_DIR, "data.example.csv")):
            hint = " - copy data.example.csv to data.csv to start"
        raise DataError("switch list not found: %s%s" % (path, hint))
    text = read_text(path)
    first = next((line for line in text.splitlines() if line.strip()), None)
    if first is None:
        raise DataError("switch list is empty: %s" % path)
    delimiter = detect_delimiter(first)
    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
    headers, rows = None, []
    report = {} if report is None else report
    report.update(delimiter=delimiter, lines=[], issues=[])
    try:
        for record in reader:
            if not any(cell.strip() for cell in record) or record[0].lstrip().startswith("#"):
                continue
            if headers is None:
                headers, seen = [], set()
                for i, h in enumerate(record):
                    h = clean(h) or "column%d" % (i + 1)
                    while h.lower() in seen:
                        h += "_"
                    seen.add(h.lower())
                    headers.append(h)
                continue
            rows.append(dict((h, clean(record[i]) if i < len(record) else "") for i, h in enumerate(headers)))
            report["lines"].append(reader.line_num)
            if len(record) != len(headers):
                report["issues"].append("line %d: %d fields, the header has %d%s" % (
                    reader.line_num, len(record), len(headers),
                    " (a '%s' inside a value?)" % delimiter if len(record) > len(headers) else ""))
    except csv.Error as e:
        raise DataError("%s, line %d: %s" % (path, reader.line_num, e))
    if headers is None:
        raise DataError("switch list has no header line: %s" % path)
    return headers, rows


class Device(object):
    __slots__ = ("values", "host", "name", "cells", "lcells", "lsegments", "search")


def find_header(headers, wanted):
    wanted = wanted.strip().lower()
    for h in headers:
        if h.lower() == wanted:
            return h
    return None


def build_devices(headers, rows, cfg):
    """Return (devices, columns, warnings, picked); columns are (header, label) pairs and
    picked is {"name": header, "host": header}.

    Which column is the switch's NAME and which is the ssh TARGET comes from the LABELS
    in `columns` first: the column you label "Name" is the name, the one you label "IP"
    is the address.  That makes an export with its own header names work with one config
    line and no code change - e.g. an Infoblox export where the hostname sits in
    PRIMARY_DN_CODE and the host address in ADDRESS, next to a SUBNET column that must
    NOT be used as either.  Without such a label the usual header names are looked for."""
    warns = []
    columns, by_label = [], {}
    for key, label in cfg.columns:
        h = find_header(headers, key)
        if h is None:
            warns.append("column '%s' not found in the switch list" % key)
        else:
            columns.append((h, label))
            by_label.setdefault(label.strip().lower(), h)

    host_h = by_label.get("ip")
    for alt in ("ip", "host", "hostname", "address", "ip address"):
        host_h = host_h or find_header(headers, alt)
    if host_h is None:
        raise DataError("no 'IP' column in the switch list (found: %s)"
                        "  - label one with  columns = <header>:IP" % ", ".join(headers))
    name_h = by_label.get("name") or find_header(headers, "name")
    if name_h is None:
        # Falling back to the first column used to happen silently, and on an export
        # whose first column is the SUBNET that made every switch in a subnet share one
        # identity - so favourites, history and the duplicate check all went wrong.
        name_h = headers[0]
        warns.append("no 'Name' column: using '%s' as the switch name"
                     " - set it with  columns = <header>:Name" % name_h)
    # Fewer than two columns resolved means the configured `columns` line is for a
    # different list, and the table would show one near-useless column - which is exactly
    # what happened with an Infoblox export, where only "subnet" matched and the table
    # showed nothing but network addresses.  Show the name and the address instead.
    if len(columns) < 2:
        if columns:
            warns.append("only %d of the configured columns exist in this list, so the table "
                         "falls back to the switch name and its address - set 'columns' to "
                         "match your list" % len(columns))
        columns = [(name_h, "Name"), (host_h, "IP")]
    picked = {"name": name_h, "host": host_h}

    devices = []
    for row in rows:
        d = Device()
        d.values = row
        d.host = row.get(host_h, "")
        d.name = row.get(name_h, "") or d.host
        d.cells = [row.get(h, "") for h, _ in columns]
        d.lcells = [c.lower() for c in d.cells]
        d.lsegments = [segments_of(c) for c in d.lcells]   # once per switch, not per keystroke
        d.search = "\x00".join(d.lcells)          # \x00: a word never matches across two columns
        devices.append(d)
    return devices, columns, warns, picked


IPV4_LIKE = re.compile(r"^[0-9.]+$")


def name_hint(devices, name_header):
    """Which other column could be the hostname?  Guessing wrong once cost a round trip,
    so the warning names the candidates: filled in, not an address, not a date."""
    for d in devices[:20]:
        found = [h for h, v in d.values.items()
                 if v and h != name_header and " " not in v and not IPV4_LIKE.match(v)]
        if found:
            return (" Columns that do have a value here: %s. Point 'Name' at the right one:"
                    "  columns = %s:Name" % (", ".join(found[:4]), found[0]))
    return " Point 'Name' at the column that holds the hostname:  columns = <header>:Name"


def data_issues(devices, lines, issues=(), name_header=None):
    """Plausibility checks for the switch list -> warnings with CSV line numbers."""
    out = list(issues)
    names, hosts, nameless = {}, {}, []
    for d, line in zip(devices, lines):
        # An empty name column shows an empty NAME cell while the switch itself falls back
        # to its IP, so the row looks half-broken without anything saying why.
        if name_header and not d.values.get(name_header, ""):
            nameless.append(line)
        if not d.host:
            out.append("line %d: '%s' has no IP" % (line, d.name))
        elif not valid_host(d.host):
            out.append("line %d: '%s' has an unusable IP/host '%s'" % (line, d.name, d.host))
        elif IPV4_LIKE.match(d.host):
            parts = d.host.split(".")
            if len(parts) != 4 or not all(p and int(p) <= 255 for p in parts):
                out.append("line %d: '%s' - '%s' is not a valid IPv4 address" % (line, d.name, d.host))
            elif any(len(p) > 1 and p.startswith("0") for p in parts):
                out.append("line %d: '%s' - '%s' has leading zeros (ping may read them as octal)"
                           % (line, d.name, d.host))
        names.setdefault(d.name.lower(), []).append(line)
        if d.host:
            hosts.setdefault(d.host, []).append("%s (line %d)" % (d.name, line))
    if nameless:
        out.append("%d row(s) have nothing in the name column '%s' (line%s %s%s) - their NAME "
                   "column stays empty and they fall back to the IP.%s"
                   % (len(nameless), name_header, "" if len(nameless) == 1 else "s",
                      ", ".join(str(n) for n in nameless[:8]), ", ..." if len(nameless) > 8 else "",
                      name_hint(devices, name_header)))
    for name, where in names.items():
        if len(where) > 1:
            out.append("name '%s' appears %d times: lines %s" % (name, len(where), ", ".join(map(str, where))))
    for host, who in hosts.items():
        if len(who) > 1:
            out.append("IP %s is used %d times: %s" % (host, len(who), ", ".join(who)))
    return out


def device_key(d):
    """Identity used for favourites and history: the name, or the host without one."""
    return d.name or d.host


BOUNDARY = " -_./:@"
NO_BOUNDARY = str.maketrans("", "", BOUNDARY)


def segments_of(text):
    """The text cut at the separators, as (offset, part) - 'ab-12-s34' becomes
    (0,'ab') (3,'12') (6,'s34').  A search word may only jump between these."""
    parts, start = [], 0
    for i, ch in enumerate(text):
        if ch in BOUNDARY:
            if i > start:
                parts.append((start, text[start:i]))
            start = i + 1
    if len(text) > start:
        parts.append((start, text[start:]))
    return parts


def anchored_positions(pattern, segments):
    """Cover the pattern with chunks of the text: the first chunk may sit anywhere
    inside a segment, every later chunk must start AT THE BEGINNING of a later one.

    That is the whole rule.  Searching w4 finds xx-xx-sxx-w4, where 'w4' sits together,
    but not wx-x4-sxx-xx, where the 4 is buried inside the segment 'x4' - while bc01
    still finds ber-core-01, because b, c and 01 each start a segment.
    Returns the matched positions, or None."""
    failed = set()

    def cover(pi, si, first):
        if pi == len(pattern):
            return []
        if (pi, si, first) in failed:
            return None
        for s in range(si, len(segments)):
            offset, part = segments[s]
            for o in (range(len(part)) if first else (0,)):
                longest = min(len(part) - o, len(pattern) - pi)
                for length in range(longest, 0, -1):     # longest chunk first: tighter match
                    if part[o:o + length] == pattern[pi:pi + length]:
                        rest = cover(pi + length, s + 1, False)
                        if rest is not None:
                            return list(range(offset + o, offset + o + length)) + rest
        failed.add((pi, si, first))
        return None

    return cover(0, 0, True)


def score_positions(text, positions):
    """How good a match is: a letter at the start of a segment counts, and so does
    every letter that follows directly on the one before."""
    score, previous = 0, None
    for pos in positions:
        score += 1
        if pos == 0 or text[pos - 1] in BOUNDARY:
            score += 8
        if previous is not None:
            score += 5 if pos == previous + 1 else -min(3, pos - previous - 1)
        previous = pos
    return score


def fuzzy_match(pattern, text, segments=None):
    """Match pattern (lower case) in text (lower case).  A word written together is
    found anywhere; otherwise it may only be split at the separators - see
    anchored_positions.  segments is segments_of(text), passed in on the hot path
    because it never changes.  Returns (score, positions) or None."""
    i = text.find(pattern)
    if i >= 0:                                   # written together: always the best match
        bonus = 30 if i == 0 or text[i - 1] in BOUNDARY else 0
        return 1000 + 2 * len(pattern) + bonus, tuple(range(i, i + len(pattern)))
    squeezed = pattern.translate(NO_BOUNDARY)
    if not squeezed or not set(squeezed) <= set(text):
        return None                              # nothing to search for, or a letter is missing
    positions = anchored_positions(squeezed, segments_of(text) if segments is None else segments)
    if positions is None:
        return None
    return score_positions(text, positions), tuple(positions)


def fuzzy_term(word):
    """Test for one search word: the best-matching visible column wins."""
    def test(d):
        best = None
        for i, cell in enumerate(d.lcells):
            m = fuzzy_match(word, cell, d.lsegments[i])
            if m and (best is None or m[0] > best[0]):
                best = (m[0], i, m[1])
        return best
    return test


def status_term(states, value):
    """ping:/ssh: filters.  'none' (and a bare 'ping:', like any other empty field:)
    = not checked yet, otherwise the start of a state."""
    if value in ("", "none"):
        return lambda d: d.host not in states
    return lambda d: d.host in states and states[d.host].startswith(value)


WILDCARD = "*?"


def has_wildcard(text):
    return any(c in text for c in WILDCARD)


def glob_match(value, pattern):
    """Does one cell match a shell-style pattern?

    The pattern has to match the WHOLE value, which is what makes it precise: *-l1 finds
    ab-12-s34-l1 and not ab-12-s34-l11, which neither fuzzy nor substring matching can
    tell apart.  Because names are usually FQDNs, the part before the first dot is tried
    too, so *-l1 works on ab-12-s34-l1.example.net without writing *-l1.* every time.
    Addresses are not split that way, so 19? cannot match 192.0.2.98 through its "192"."""
    if fnmatch.fnmatchcase(value, pattern):
        return True
    head = value.split(".", 1)[0]
    return head != value and not IPV4_LIKE.match(value) and fnmatch.fnmatchcase(head, pattern)


def glob_term(pattern):
    """A word containing * or ? is a pattern over one whole visible column."""
    def test(d):
        return any(glob_match(cell, pattern) for cell in d.lcells)
    return test


def exact_term(token, fields, status, favorites, recent, marked=()):
    """Every non-fuzzy term -> test function returning True / False."""
    name, sep, value = token.partition(":")
    if sep:
        if name == "is":
            if value == "fav":
                return lambda d: device_key(d) in favorites
            if value == "recent":
                return lambda d: device_key(d) in recent
            if value == "marked":
                return lambda d: device_key(d) in marked
        if name in ("ping", "ssh"):
            return status_term(status.get(name, {}), value)
        header = fields.get(name)
        if header is not None:
            if not value:
                return lambda d: not d.values.get(header)
            if has_wildcard(value):      # name:*-l1 is a pattern over that column
                return lambda d: glob_match(d.values.get(header, "").lower(), value)
            return lambda d: value in d.values.get(header, "").lower()
    # plain text - also unknown "x:y" such as IPv6 addresses
    return lambda d: token in d.search


def known_field(text, fields):
    """True when text starts with a field: prefix TRuffle knows about."""
    name, sep, _ = text.partition(":")
    return bool(sep) and (name in ("is", "ping", "ssh") or name in (fields or {}))


def alternatives(token, fields):
    """Split one term on '|' into its alternatives.  An alternative with no field: prefix
    of its own inherits the first one's, so ping:up|wait means "up or wait" rather than
    "ping:up, or the word wait somewhere"."""
    parts = [p for p in token.split("|") if p]
    if not parts:
        return []
    prefix = ""
    if known_field(parts[0], fields):
        prefix = parts[0].partition(":")[0] + ":"
    return [parts[0]] + [p if known_field(p, fields) else prefix + p for p in parts[1:]]


def filter_devices(devices, query, fields=None, status=None, favorites=(), recent=None, found=None,
                   marked=()):
    """Space separated terms, ALL of which must match (case-insensitive):
         word          a word written together, found anywhere in a visible column; it may be
                       split only AT THE SEPARATORS (bc01 -> ber-core-01, but w4 does not
                       find wx-x4-sxx-xx, where the 4 is buried inside a segment)
         'word         exact: part of a visible column
         *-l1  ??-??-s??-w3     pattern: * and ? over one WHOLE visible column
         field:value   part of that CSV column (header or table label), field: = empty,
                       and a pattern when it contains * or ?
         ping:down     ping state: up, down, wait, none     ssh:failed  last ssh try: ok, failed, none
         is:fav        favourites    is:recent  connected to    is:marked  picked with Tab
         -term         excludes, e.g. -test  -type:edge  -ping:up  -*-w4
         a|b           ONE term, either alternative: w3|w4, ping:up|wait, *-w3|*-w4
    Space stays AND on purpose - it is what makes narrowing a 843-switch list work - so OR
    is written inside a term with '|'.
    If found is a dict, it receives device -> (score, {column: positions}) for fuzzy words."""
    fields, status, recent = fields or {}, status or {}, recent or {}
    tests = []
    for token in query.lower().split():
        if token.strip("'-|") == "":                 # just started typing a term: no filter yet
            continue
        negate = len(token) > 1 and token.startswith("-")
        if negate:
            token = token[1:]
        alts = []
        for alt in alternatives(token, fields):
            if alt.startswith("'") and len(alt) > 1:
                alts.append((False, exact_term(alt[1:], fields, status, favorites, recent, marked)))
            elif known_field(alt, fields) or (negate and not has_wildcard(alt)):
                # an excluded word stays exact: a fuzzy exclude hides far too much (D16)
                alts.append((False, exact_term(alt, fields, status, favorites, recent, marked)))
            elif has_wildcard(alt):
                alts.append((False, glob_term(alt)))
            else:
                alts.append((True, fuzzy_term(alt)))
        if alts:
            tests.append((negate, alts))
    if not tests:
        return list(devices)
    out = []
    for d in devices:
        score, marks = 0, {}
        for negate, alts in tests:
            hit, best = False, None
            for fuzzy, test in alts:
                result = test(d)
                if fuzzy:
                    if result is not None:
                        hit = True
                        if best is None or result[0] > best[0]:
                            best = result       # the best-scoring alternative is highlighted
                elif result:
                    hit = True
            if hit == negate:
                break
            if best is not None:
                score += best[0]
                marks.setdefault(best[1], set()).update(best[2])
        else:
            out.append(d)
            if found is not None and marks:
                found[d] = (score, marks)
    return out


def default_order(view, query, favorites, recent, found=None):
    """Order without a chosen sort column: newest first for is:recent; otherwise
    favourites pinned on top, and with fuzzy words the best matches first."""
    if "is:recent" in query.lower().split():
        return sorted(view, key=lambda d: recent.get(device_key(d), 0), reverse=True)
    view = [d for d in view if device_key(d) in favorites] + [d for d in view if device_key(d) not in favorites]
    if found:
        view.sort(key=lambda d: -found.get(d, (0,))[0])    # stable: favourites win ties
    return view


def paste_text(raw, multiline=True):
    """Pasted text turned into something safe to put in a field.  Control characters are
    dropped (so a pasted tab cannot mark a switch and a pasted newline cannot run ssh).
    For the search, line breaks become spaces - all terms must match, so a pasted list
    simply matches nothing and you see that at once.  For a password field only the
    first line is taken."""
    lines = [CONTROL_CHARS.sub("", line) for line in re.split(r"[\r\n]", raw or "")]
    lines = [line for line in lines if line]
    if not multiline:
        return lines[0][:MAX_PASTE] if lines else ""
    return " ".join(lines)[:MAX_PASTE]


def set_or_clear(mapping, key, text):
    """Store text under key, or drop the key when there is nothing to store - so an
    empty detail never lingers as an empty string."""
    if text:
        mapping[key] = text
    else:
        mapping.pop(key, None)


def minutes_text(minutes):
    """'10 h', '1 h 30 min', '45 min' - never a rounded-off lie like '2 h' for 90."""
    if minutes >= 60 and minutes % 60 == 0:
        return "%d h" % (minutes // 60)
    if minutes > 60:
        return "%d h %d min" % (minutes // 60, minutes % 60)
    return "%d min" % minutes


def creds_expired(now, entered_at, minutes):
    """True when the password was typed more than `minutes` ago (0 minutes = never).

    Absolute, not idle: measured from when it was TYPED, so a window someone keeps
    touching cannot hold a live credential for days.  Expiry only forgets the password
    inside TRuffle - sessions and tmux panes are never disturbed."""
    return bool(minutes) and now - entered_at > minutes * 60


class UserState(object):
    """Favourites and connection history of the current user, kept in
    ~/.local/state/truffle - never in the shared directory."""

    MAX_RECENT = 200

    def __init__(self, directory):
        self.dir = directory
        self.favorites = set()
        self.recent = {}               # device key -> time of the last successful connection
        self.error = None
        self.load()

    def _path(self, name):
        return os.path.join(self.dir, name)

    def load(self):
        self.favorites = set(line.strip() for line in self._read("favorites") if line.strip())
        self.recent = {}
        for line in self._read("recent"):
            stamp, _, key = line.rstrip("\n").partition("\t")
            try:
                if key:
                    self.recent[key] = max(float(stamp), self.recent.get(key, 0))
            except ValueError:
                pass

    def _read(self, name):
        try:
            with open(self._path(name), encoding="utf-8") as f:
                return f.readlines()
        except FileNotFoundError:
            return []
        except (OSError, UnicodeDecodeError) as e:
            self.error = "cannot read %s: %s" % (self._path(name), e)
            return []

    def _write(self, name, lines):
        path = self._path(name)
        tmp = "%s.%d.tmp" % (path, os.getpid())
        try:
            os.makedirs(self.dir, mode=0o700, exist_ok=True)
            with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8") as f:
                f.write("".join(line + "\n" for line in lines))
            os.replace(tmp, path)          # atomic: a crash never leaves half a file
            self.error = None
        except OSError as e:
            self.error = "cannot save %s: %s" % (path, e.strerror or e)
            try:
                os.unlink(tmp)
            except OSError:
                pass

    def toggle_favorite(self, key):
        self.load()                        # another TRuffle of the same user may have changed it
        if key in self.favorites:
            self.favorites.discard(key)
        else:
            self.favorites.add(key)
        self._write("favorites", sorted(self.favorites))
        return key in self.favorites

    def load_status(self):
        """Saved ping / SSH results: (states, times, details) where states is
        {"ping": {host: word}, "ssh": {...}}, times is {(kind, host): time} and details
        is {(kind, host): text} - today only the reason a ssh attempt failed.

        A line is `host TAB kind TAB state TAB time` with an optional 5th detail field.
        Both lengths are accepted on purpose: a TRuffle without the detail field keeps
        reading every line that has none, instead of dropping the whole file."""
        status = dict((kind, {}) for kind in STATUS_KINDS)
        checked, detail = {}, {}
        for line in self._read("status"):
            parts = line.rstrip("\n").split("\t")
            if len(parts) in (4, 5) and parts[1] in status and parts[2] in CHECKED_STATES:
                host, kind, state, stamp = parts[:4]
                try:
                    stamp = float(stamp)
                except ValueError:
                    continue
                if stamp >= checked.get((kind, host), 0):
                    status[kind][host], checked[(kind, host)] = state, stamp
                    set_or_clear(detail, (kind, host), parts[4].strip() if len(parts) == 5 else "")
        return status, checked, detail

    def save_status(self, status, checked, detail=None):
        """Merge our results into the saved ones (newest wins, another TRuffle may
        have checked other switches meanwhile) and write them back."""
        saved, saved_checked, saved_detail = self.load_status()
        detail = detail or {}
        for kind, states in status.items():
            # list(): a batch ping still restoring cancelled hosts deletes keys from
            # this very dict from its worker threads - iterating it live would raise
            # "dictionary changed size during iteration" over the curses screen.
            for host, state in list(states.items()):
                stamp = checked.get((kind, host), 0)
                if state in CHECKED_STATES and stamp >= saved_checked.get((kind, host), 0):
                    saved[kind][host], saved_checked[(kind, host)] = state, stamp
                    set_or_clear(saved_detail, (kind, host), clean(detail.get((kind, host), "")))
        lines = []
        for kind in STATUS_KINDS:
            for host, state in sorted(saved[kind].items()):
                row = [host, kind, state, "%d" % saved_checked.get((kind, host), 0)]
                text = saved_detail.get((kind, host), "")
                lines.append("\t".join(row + [text] if text else row))   # 4 fields when empty
        self._write("status", lines)

    def touch(self, key):
        self.load()
        self.recent[key] = time.time()
        newest = sorted(self.recent.items(), key=lambda item: item[1], reverse=True)[:self.MAX_RECENT]
        self.recent = dict(newest)
        self._write("recent", ["%d\t%s" % (stamp, k) for k, stamp in reversed(newest)])

    # A tmux pane cannot tell TRuffle anything over the socket (it is closed once the
    # panes have their login), so a wrong password is reported through this file -
    # the same way results are.  TRuffle then wipes the password it holds, instead of
    # spending it on switch after switch (a central TACACS+/RADIUS account would lock).
    def note_auth_failure(self, host):
        # Sub-second precision on purpose: a pane can fail within the same second as
        # the password was entered, and a whole-second stamp would then look older
        # than the password it belongs to - so the wipe would be skipped.
        self._write("authfail", ["%.3f\t%s" % (time.time(), host)])

    def load_auth_failure(self):
        """(time, host) of the last login failure reported by a pane, or (0, "")."""
        for line in self._read("authfail"):
            stamp, _, host = line.rstrip("\n").partition("\t")
            try:
                return float(stamp), host
            except ValueError:
                pass
        return 0.0, ""


def natural_key(text):
    """'sw2' < 'sw10', '10.0.1.2' < '10.0.1.10'."""
    key = []
    for i, part in enumerate(re.split(r"([0-9]+)", text.lower())):
        if i % 2:
            key.append((0, int(part), ""))
        elif part:
            key.append((1, 0, part))
    return key


def next_sort(sort_col, sort_desc, col):
    """Pressing a column's sort key: ascending -> descending -> off (original order)."""
    if sort_col != col:
        return col, False
    if not sort_desc:
        return col, True
    return None, False


def sort_devices(devices, col, desc, status=()):
    """col indexes the visible columns, then the status columns (status holds one dict
    per STATUS_COLUMNS entry; problems sort first).  Empty values always go last."""
    if col is None or not devices:
        return list(devices)
    if col >= len(devices[0].cells):
        states = status[col - len(devices[0].cells)]

        def value(d):
            return states.get(d.host, "")
        key = lambda d: STATUS_RANK.get(value(d), 9)
    else:
        def value(d):
            return d.cells[col]
        key = lambda d: natural_key(value(d))
    filled = [d for d in devices if value(d) != ""]
    empty = [d for d in devices if value(d) == ""]
    return sorted(filled, key=key, reverse=desc) + empty


