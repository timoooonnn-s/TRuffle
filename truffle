# ---------------------------------------------------------------------------
# How long TRuffle keeps the password you typed.
#
# THIS IS THE ONE NUMBER TO CHANGE if the team wants it longer or shorter.  It is the
# default for `password_lifetime` in truffle.conf, so a single site can still override
# it without touching the code.
#
#   600 = 10 hours  (one long working day: never expires while you work, always has
#                    expired by the next morning)
#    60 = 1 hour    0 = never forget it, keep it until TRuffle exits
#
# It is measured from the moment you TYPED the password, not from your last keypress -
# so touching the window cannot keep it alive for days.
#
# What expiry does and does NOT do:
#   does      - forget the password inside TRuffle, so the next ssh asks again
#   does NOT  - touch anything you are connected to.  A switch session you are sitting
#               in keeps running, and tmux panes keep running and stay logged in.  The
#               password is only deleted from TRuffle, never from your workspace.
# ---------------------------------------------------------------------------
PASSWORD_LIFETIME_MINUTES = 600

# Bracketed paste: the terminal wraps pasted text in ESC[200~ ... ESC[201~, so a pasted
# newline is text and not Enter (which would have run ssh on whatever row was selected).
PASTE_ON, PASTE_OFF = b"\033[?2004h", b"\033[?2004l"
PASTE = {"text": ""}                  # the last pasted block, read by read_key's callers
MAX_PASTE = 512
HUGE_PASTE = 1 << 20                  # hard stop: a terminal that never sends the end marker

# "64 bytes from 10.0.0.1: icmp_seq=1 ttl=63 time=1.23 ms"  (ping runs with LC_ALL=C).
# The "time=" is what proves a real echo reply: a router's "Destination Net Unreachable"
# also prints a "bytes from" line and on macOS even exits 0.  See ping_verdict.
REPLY_RE = re.compile(r"\btime[=<]\s*[0-9]", re.IGNORECASE)

# fork() while batch-ping threads run raises a DeprecationWarning on Python 3.12+.
# The child execs immediately, so it is safe; the warning would only garble the screen.
warnings.filterwarnings("ignore", category=DeprecationWarning)


