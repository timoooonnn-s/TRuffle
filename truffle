class App(object):

    def __init__(self, scr, cfg):
        self.scr, self.cfg = scr, cfg
        self.th = Theme(cfg.charset)
        self.devices, self.view, self.columns, self.widths = [], [], [], []
        self.cursor = self.top = self.cmd = 0
        self.body_h = 1
        self.query = ""
        self.sort_col, self.sort_desc = None, False
        self.ping = {}                 # host -> PING_UP / PING_DOWN / WAIT
        self.ssh = {}                  # host -> SSH_OK / SSH_FAILED: your last real ssh attempt
        self.checked = {}              # (kind, host) -> time of that ping / SSH result
        self.detail = {}               # (kind, host) -> the reason a ssh attempt failed
        self.issues = []
        self.found = {}                # device -> (score, {column: positions}) of fuzzy words
        self.marked = {}               # device key -> True, in the order you marked them.
                                       # A dict, not a set: the order decides the pane order,
                                       # and marks survive a new search (see marked_devices)
        self.my_sessions = []          # tmux sessions this TRuffle started and still running
        self.sessions_foreign = False  # ... and whether those belong to another TRuffle window
        self._sessions_checked = 0.0
        self.batch = None
        self.creds = None              # (user, password or None) - memory only
        self.creds_at = 0.0            # when it was typed; forgotten PASSWORD_LIFETIME later
        self.authfail_seen = 0.0       # last login failure a tmux pane reported
        self.state = UserState(cfg.state_dir)
        self.fields = {}               # lower-case header / label -> CSV header (for field:value)
        self.last_user = cfg.user
        self.msg, self.msg_error, self.msg_until = "", False, 0
        self.load_error = None
        self.set_cursor(False)
        saved, self.checked, self.detail = self.state.load_status()      # the last check's results
        self.ping, self.ssh = saved["ping"], saved["ssh"]
        bracketed_paste(True)
        self.load()
        if self.state.error:
            self.message(self.state.error, error=True, seconds=15)
        elif self.checked and not self.load_error and not self.issues:
            last = max(self.checked.values())
            self.message("Ping / SSH results from the last check (%s) - ping refreshes them"
                         % time.strftime("%Y-%m-%d %H:%M", time.localtime(last)), seconds=8)

    # -- helpers ------------------------------------------------------------

    def set_cursor(self, visible):
        try:
            curses.curs_set(1 if visible else 0)
        except curses.error:
            pass

    def message(self, text, error=False, seconds=6):
        self.msg = text
        self.msg_error = error
        self.msg_until = time.time() + seconds

    def selected(self):
        return self.view[self.cursor] if 0 <= self.cursor < len(self.view) else None

    def ncols(self):
        return len(self.columns) + len(STATUS_COLUMNS)

    def results(self):
        """The one place that maps a status kind to the dict holding it."""
        return {"ping": self.ping, "ssh": self.ssh}

    def column_results(self):
        """One dict per status column, in STATUS_COLUMNS order (for drawing / sorting)."""
        data = self.results()
        return [data[kind] for kind in STATUS_KINDS]

    def marked_devices(self):
        """Every marked switch, in the order you marked them - deliberately NOT filtered by
        the current search.  Marking builds a selection up: search, mark a couple, search
        for something else, mark a couple more, then ssh to all of them.  'is:marked' shows
        what you have collected so far."""
        first = {}
        for d in self.devices:
            first.setdefault(device_key(d), d)
        return [first[key] for key in self.marked if key in first]

    def toggle_mark(self, dev):
        key = device_key(dev)
        if key in self.marked:
            del self.marked[key]
        else:
            self.marked[key] = True

    def set_status(self, kind, host, state, detail=None):
        """One result.  detail is the reason a ssh attempt failed; it is saved with the
        result, so it survives a restart and details can still show it."""
        self.results()[kind][host] = state
        self.checked[(kind, host)] = time.time()
        set_or_clear(self.detail, (kind, host), detail)

    def save_status(self):
        self.state.save_status(self.results(), self.checked, self.detail)
        if self.state.error:
            self.message(self.state.error, error=True, seconds=10)

    def forget_creds(self, why):
        self.creds = None
        self.message("Password forgotten (%s) - you will be asked again." % why, seconds=15)

    def check_pane_auth_failure(self):
        """A tmux pane could not log in: drop the password instead of spending it on
        switch after switch (a central TACACS+/RADIUS account would lock out)."""
        stamp, host = self.state.load_auth_failure()
        if stamp <= self.authfail_seen:
            return
        self.authfail_seen = stamp
        if self.creds and stamp >= self.creds_at:      # it was THIS password that failed
            self.forget_creds("a tmux pane could not log in to %s" % host)

    def reload_status(self):
        """Pick up results another TRuffle - or one of our tmux panes - has written."""
        saved, checked, detail = self.state.load_status()
        mine_by_kind = self.results()
        for kind, states in saved.items():
            mine = mine_by_kind[kind]
            for host, state in states.items():
                if checked.get((kind, host), 0) >= self.checked.get((kind, host), 0):
                    mine[host], self.checked[(kind, host)] = state, checked[(kind, host)]
                    set_or_clear(self.detail, (kind, host), detail.get((kind, host), ""))
        self.state.load()                   # favourites and the recent list too
        self.check_pane_auth_failure()
        self.status_changed(force=True)

    def load(self):
        keep = self.selected()
        try:
            report = {}
            headers, rows = read_table(self.cfg.data, report)
            devices, columns, warns, picked = build_devices(headers, rows, self.cfg)
        except DataError as e:
            self.load_error = str(e)
            self.devices = self.loaded = []
            self.columns = self.columns or list(self.cfg.columns)
            self.message(str(e), error=True, seconds=30)
        else:
            self.load_error = None
            self.devices, self.columns = devices, columns
            self.loaded = devices          # CSV order, used when sorting is switched off
            self.fields = dict((h.lower(), h) for h in headers)
            self.fields.update((label.lower(), h) for h, label in columns)
            self.issues = data_issues(devices, report["lines"], report["issues"], picked["name"])
            if warns:
                self.message("; ".join(warns), error=True, seconds=15)
            elif self.issues:
                self.message("%d warning%s in the switch list - run: truffle --check"
                             % (len(self.issues), "" if len(self.issues) == 1 else "s"), error=True, seconds=15)
        self.widths = [min(40, max([len(label) + 2] + [len(d.cells[i]) for d in self.devices]))
                       for i, (_, label) in enumerate(self.columns)]
        self.widths += [width for _, width, _ in STATUS_COLUMNS]
        if keep is not None:
            keep = next((d for d in self.devices if d.host == keep.host and d.name == keep.name), None)
        self.apply_sort(keep)

    def apply_sort(self, keep=None):
        self.devices = sort_devices(self.loaded, self.sort_col, self.sort_desc, self.column_results())
        self.refilter(keep)

    def refilter(self, keep=None):
        keep = keep or self.selected()
        state = self.state
        self.found = {}
        view = filter_devices(self.devices, self.query, self.fields, self.results(),
                              state.favorites, state.recent, self.found, marked=self.marked)
        if self.sort_col is None:
            view = default_order(view, self.query, state.favorites, state.recent, self.found)
        self.view = view
        self.cursor = 0
        for i, d in enumerate(self.view):
            if d is keep:
                self.cursor = i
                break

    def set_sort(self, col, desc=None):
        """col None = original order.  Without desc: ascending -> descending -> off."""
        if col is not None and col >= self.ncols():
            return
        if desc is None:
            self.sort_col, self.sort_desc = next_sort(self.sort_col, self.sort_desc, col)
        else:
            self.sort_col, self.sort_desc = col, desc
        self.apply_sort()
        if self.sort_col is None:
            self.message("Original order")

    def status_changed(self, keep=None, force=False):
        """New ping / ssh results: keep a status sort and ping: / ssh: searches up to
        date.  force also covers is:recent and favourites after a session."""
        if self.sort_col is not None and self.sort_col >= len(self.columns):
            self.apply_sort(keep)                       # includes a refilter
        elif force or "ping:" in self.query.lower() or "ssh:" in self.query.lower():
            self.refilter(keep)

    def check_sessions(self):
        """Which of our tmux sessions are still alive - they hold open switch logins.
        When one ends, its panes have written their results, so pick them up."""
        if not self.my_sessions or time.time() - self._sessions_checked < 3:
            return
        # Do not wait for the session to end: a pane that could not log in has already
        # said so, and the password it used must go now, not in an hour.
        self.check_pane_auth_failure()
        before = self.my_sessions
        self.live_sessions()
        ended = [s for s in before if s not in self.my_sessions]
        if ended:
            self.reload_status()
            self.message("tmux session %s ended" % ", ".join(ended))

    def sync_size(self):
        size = terminal_size()
        if size and size != self.scr.getmaxyx():
            try:
                curses.resizeterm(*size)
            except curses.error:
                pass
        self.scr.clear()

    # -- drawing ------------------------------------------------------------
    #
    #  TRuffle  Switch Manager                          timmy · 2/29 switches   top bar
    # ───────────────────────────────────────────────────────────────────────  rule
    #   ssh   ping   details   help   exit                                      tabs
    #   ›  ber core                                                              search
    #    NAME          IP           ...                              PING        table head
    #    ────────────────────────────────────────────────────────────────        rule
    #  ▌* ber-core-01  192.0.2.1    ...                              ● up        rows
    # ───────────────────────────────────────────────────────────────────────  rule
    #  Enter run  ←→ command  Tab mark  ^F favourite  F1-F7 sort  ^G settings  ... footer

    TABLE_X = 5          # column 1: selection marker, 2: favourite star, 3: multi-ssh mark

    def layout(self):
        h, w = self.scr.getmaxyx()
        gap = 2 if h >= 22 else 1         # blank rows between the blocks when there is room
        y_tabs = 1 + gap
        y_search = y_tabs + gap
        y_head = y_search + gap
        return h, w, y_tabs, y_search, y_head

    def draw_frame(self, subtitle, right="", right_attr=None, hints=(), footer_right="", footer_attr=None,
                   show_message=True):
        """Top bar + rule, footer rule + key hints / message.  Shared by all screens."""
        scr, th, sym = self.scr, self.th, self.th.sym
        h, w = scr.getmaxyx()
        put(scr, 0, 2, "TRuffle", th.brand)
        put(scr, 0, 11, subtitle[:max(0, w - 14 - len(right))], th.brand_sub)
        if right:
            put(scr, 0, max(0, w - len(right) - 2), right, th.info if right_attr is None else right_attr)
        put(scr, 1, 0, sym["hline"] * w, th.rule)
        put(scr, h - 2, 0, sym["hline"] * w, th.rule)

        if footer_right:
            put(scr, h - 1, max(0, w - len(footer_right) - 2), footer_right,
                th.hint if footer_attr is None else footer_attr)
        room = w - (len(footer_right) + 4 if footer_right else 2)
        if show_message and time.time() < self.msg_until:
            text = sym["dot"] + " " + self.msg
            if len(text) > room:                  # a message beats the right-hand info
                room = w - 3
                put(scr, h - 1, 0, " " * (w - 1))
            put(scr, h - 1, 2, fit(text, room, sym["more"]).rstrip(), th.err if self.msg_error else th.msg)
            return
        x = 2
        for key, label in hints:
            if x + len(key) + len(label) + 1 > room:
                break
            put(scr, h - 1, x, key, th.key)
            put(scr, h - 1, x + len(key) + 1, label, th.hint)
            x += len(key) + len(label) + 3

    def draw(self, refresh=True):
        scr, th, sym = self.scr, self.th, self.th.sym
        scr.erase()
        h, w, y_tabs, y_search, y_head = self.layout()
        if h < 10 or w < 40:
            put(scr, 0, 1, "TRuffle", th.brand)
            put(scr, 1, 1, "Terminal too small", th.err)
            put(scr, 2, 1, "min. 40 x 10", th.hint)
            if refresh:
                scr.refresh()
            return

        right = "%d/%d switches" % (len(self.view), len(self.devices))
        if self.creds:
            right = "%s %s %s" % (self.creds[0], sym["sep"], right)
        if self.marked:
            right = "%d marked %s %s" % (len(self.marked), sym["sep"], right)
        if self.my_sessions:
            right = "%d tmux %s %s" % (len(self.my_sessions), sym["sep"], right)
        batch = ""
        if self.batch and self.batch.running and not self.batch.cancelled:
            batch = "ping %d%%" % self.batch.percent
            if not self.query:
                batch += " %s ESC cancels" % sym["sep"]
        hints = [("Enter", "run"), (sym["lr"], "command"), ("Tab", "mark"), ("^F", "favourite"),
                 ("F1-F%d" % self.ncols(), "sort"), ("^G", "settings"),
                 ("^R", "reload"), ("^C", "quit")]
        if self.my_sessions:
            hints.insert(3, ("^T", "back to tmux"))
            hints.insert(4, ("^K", "close tmux"))
        if batch:
            self.draw_frame("Switch Manager", right, hints=hints, footer_right=batch, footer_attr=th.wait)
        else:
            self.draw_frame("Switch Manager", right, hints=hints, footer_right=CREDIT, footer_attr=th.placeholder)

        # command tabs
        if 2 + sum(len(c) + 3 for c in COMMANDS) <= w:
            x = 2
            for i, name in enumerate(COMMANDS):
                put(scr, y_tabs, x, " %s " % name, th.tab_active if i == self.cmd else th.tab)
                x += len(name) + 3
        else:                                       # narrow terminal: only the selected command
            name = COMMANDS[self.cmd]
            put(scr, y_tabs, 2, sym["lt"], th.tab)
            put(scr, y_tabs, 4, " %s " % name, th.tab_active)
            put(scr, y_tabs, 7 + len(name), sym["gt"], th.tab)

        # search: "-" and "field:" parts of terms are highlighted
        put(scr, y_search, 2, sym["prompt"], th.prompt)
        shown = self.query[-(w - 9):]
        x = 5
        for part in re.split(r"(\s+)", shown):
            neg = part[:1] if len(part) > 1 and part[0] in "-'" else ""
            name, sep, value = part[len(neg):].partition(":")
            neg_attr = th.err if neg == "-" else th.key
            if known_field(part[len(neg):].lower(), self.fields):
                pieces = [(neg, neg_attr), (name + sep, th.key), (value, th.text)]
            else:
                pieces = [(neg, neg_attr), (part[len(neg):], th.text)]
            for text, attr in pieces:
                put(scr, y_search, x, text, attr)
                x += len(text)
        put(scr, y_search, x, " ", th.cursor)
        if not self.query:
            put(scr, y_search, 7, "type to search %s 'exact  *-w4  w3|w4  type:core  -test  is:fav" % sym["sep"],
                th.placeholder)

        # table head
        x0 = self.TABLE_X
        widths = fit_widths(self.widths, w - x0 - 3 - 2 * (len(self.widths) - 1))
        table_w = sum(widths) + 2 * (len(widths) - 1)
        labels = [label for _, label in self.columns] + [label for label, _, _ in STATUS_COLUMNS]
        x = x0
        for i, label in enumerate(labels):
            label = label.upper()
            put(scr, y_head, x, fit(label, widths[i], sym["more"]), th.head)
            if i == self.sort_col and len(label) + 2 <= widths[i]:
                put(scr, y_head, x + len(label) + 1, sym["down"] if self.sort_desc else sym["up"], th.sort)
            x += widths[i] + 2
        put(scr, y_head + 1, x0, sym["hline"] * table_w, th.rule)

        # rows
        y_body = y_head + 2
        self.body_h = body_h = max(1, h - 2 - y_body)
        if self.cursor >= len(self.view):
            self.cursor = max(0, len(self.view) - 1)
        if self.cursor < self.top:
            self.top = self.cursor
        elif self.cursor >= self.top + body_h:
            self.top = self.cursor - body_h + 1
        self.top = max(0, min(self.top, max(0, len(self.view) - body_h)))

        if not self.view:
            if self.load_error:
                text, attr = self.load_error, th.err
            elif self.devices:
                text, attr = "No switch matches '%s'  %s  ESC clears the search" % (self.query, sym["sep"]), th.placeholder
            else:
                text, attr = "The switch list is empty", th.placeholder
            put(scr, y_body + 1, x0, text, attr)

        for row in range(body_h):
            idx = self.top + row
            if idx >= len(self.view):
                break
            d = self.view[idx]
            y = y_body + row
            sel = idx == self.cursor
            if sel:
                put(scr, y, 1, sym["marker"], th.marker)
                put(scr, y, 2, " " * (w - 4), th.sel)
            if device_key(d) in self.state.favorites:
                put(scr, y, 2, "*", th.fav_sel if sel else th.fav)
            if device_key(d) in self.marked:
                put(scr, y, 3, "+", th.mark_sel if sel else th.mark)
            x = x0
            marks = self.found.get(d, (0, {}))[1]
            for i, value in enumerate(d.cells):
                shown = fit(value, widths[i], sym["more"])
                put(scr, y, x, shown, th.sel if sel else th.text)
                visible = len(value) if len(value) <= widths[i] else widths[i] - 1
                if len(d.lcells[i]) != len(value):     # lower() changed the length: positions unreliable
                    visible = 0
                for pos in marks.get(i, ()):           # letters that matched the search
                    if pos < visible:
                        put(scr, y, x + pos, value[pos], th.match_sel if sel else th.match)
                x += widths[i] + 2
            for k, states in enumerate(self.column_results()):
                state = states.get(d.host)
                width = widths[len(d.cells) + k]
                if state:
                    style = STATUS_STYLE.get(state, "wait") + ("_sel" if sel else "")
                    put(scr, y, x, fit("%s %s" % (sym["dot"], state), width), getattr(th, style))
                x += width + 2

        # scrollbar when the list is longer than the screen
        if len(self.view) > body_h:
            thumb = max(1, body_h * body_h // len(self.view))
            pos = self.top * (body_h - thumb) // max(1, len(self.view) - body_h)
            for row in range(body_h):
                inside = pos <= row < pos + thumb
                put(scr, y_body + row, w - 1, sym["thumb"] if inside else sym["track"],
                    th.marker if inside else th.rule)
        if refresh:
            scr.refresh()

    # -- main loop ----------------------------------------------------------

    def run(self):
        try:
            while True:
                self.check_sessions()
                self.check_password_lifetime()
                if self.batch and not self.batch.running and not self.batch.reported:
                    self.batch.reported = True
                    if not self.batch.cancelled:
                        self.message("Ping done: %s" % self.batch.summary(), seconds=20)
                    self.save_status()
                    self.status_changed()
                self.draw()
                key = read_key(self.scr, 250)
                if key is None:
                    continue
                if self.handle(key) is False:
                    break
        except KeyboardInterrupt:
            pass                                      # Ctrl-C: still save what we have
        if self.batch:
            self.batch.cancel()
            self.save_status()                        # finished pings are not thrown away

    def check_password_lifetime(self):
        """Forget the password password_lifetime minutes after it was typed.

        This only deletes it from TRuffle.  Nothing you are connected to is touched: a
        switch session you are sitting in is not interrupted (this check only runs while
        TRuffle has the screen), and tmux panes keep running and stay logged in."""
        if self.creds and creds_expired(time.time(), self.creds_at, self.cfg.password_lifetime):
            self.forget_creds("typed %s ago" % minutes_text(self.cfg.password_lifetime))

    def set_creds(self, creds):
        self.creds = creds
        self.creds_at = time.time()

    def handle(self, key):
        n = len(self.view)
        if key == "PASTE":
            # Pasted text is text: no Enter runs a command, no Tab marks a switch.
            text = paste_text(PASTE["text"])
            PASTE["text"] = ""
            if text:
                self.query += text
                self.refilter()
            return None
        if key == "RESIZE":
            self.sync_size()
        elif key == "UP":
            self.cursor = max(0, self.cursor - 1)
        elif key == "DOWN":
            self.cursor = min(max(0, n - 1), self.cursor + 1)
        elif key == "PGUP":
            self.cursor = max(0, self.cursor - self.body_h)
        elif key == "PGDN":
            self.cursor = min(max(0, n - 1), self.cursor + self.body_h)
        elif key == "HOME":
            self.cursor = 0
        elif key == "END":
            self.cursor = max(0, n - 1)
        elif key == "LEFT":
            self.cmd = (self.cmd - 1) % len(COMMANDS)
        elif key == "RIGHT":
            self.cmd = (self.cmd + 1) % len(COMMANDS)
        elif key == "ENTER":
            return self.execute()
        elif key in ("TAB", "BTAB"):            # mark switches for ssh / ping
            if key == "BTAB":
                self.cursor = max(0, self.cursor - 1)
            dev = self.selected()
            if dev is not None:
                at = self.cursor
                self.toggle_mark(dev)
                if "is:marked" in self.query.lower():
                    # the list IS the marks here, so an unmarked row has to leave it -
                    # otherwise the + disappears while the row stays and the screen
                    # contradicts the count.  The next row slides up under the cursor,
                    # which is what you want when pruning a selection.
                    self.refilter()
                    self.cursor = max(0, min(at, len(self.view) - 1))
                elif key == "TAB":
                    self.cursor = min(max(0, n - 1), self.cursor + 1)
        elif key.startswith("F") and key[1:].isdigit():
            self.set_sort(int(key[1:]) - 1)
        elif key == "BACKSPACE":
            if self.query:
                self.query = self.query[:-1]
                self.refilter()
        elif key == "CTRL_U":
            self.query = ""
            self.refilter()
        elif key == "CTRL_W":
            words = self.query.split()
            self.query = " ".join(words[:-1]) + (" " if len(words) > 1 else "")
            self.refilter()
        elif key == "ESC":                   # one step: search, running ping, marks, sort
            if self.query:
                self.query = ""
                self.refilter()
            elif self.batch and self.batch.running and not self.batch.cancelled:
                # Before the marks: a ping needs 2+ marks, so the marks are ALWAYS set
                # while one runs - clearing them first made the footer's "ESC cancels"
                # a lie that took two presses to honour.  "not cancelled" matches what the
                # footer shows: workers can sit in an in-flight ping for seconds after a
                # cancel, and ESC must not stay stuck on this branch meanwhile.
                self.batch.cancel()
                self.message("Ping cancelled")
            elif self.marked:
                self.marked.clear()
                self.message("Marks cleared")
            elif self.sort_col is not None:
                self.set_sort(None, desc=False)
        elif key == "CTRL_F":
            dev = self.selected()
            if dev is not None:
                added = self.state.toggle_favorite(device_key(dev))
                if self.state.error:
                    self.message(self.state.error, error=True, seconds=10)
                else:
                    self.message("%s %s favourites" % (dev.name, "added to" if added else "removed from"))
                self.refilter(dev)
        elif key == "CTRL_T":
            self.reattach()
        elif key == "CTRL_K":
            self.close_sessions()
        elif key == "CTRL_G":
            self.settings()
        elif key == "CTRL_R":
            self.load()
            if not self.load_error:
                self.message("Switch list reloaded: %d switches" % len(self.devices))
        elif key == "CTRL_L":
            self.scr.clear()
        elif len(key) == 1:
            self.query += key
            self.refilter()
        return None

    def execute(self):
        command = COMMANDS[self.cmd]
        if command == "exit":
            return False
        if command == "help":
            return self.show_help()
        if command in ("ssh", "ping"):
            # Several marked switches: decided on the marks that resolve to a switch with a
            # usable address (a mark left over from a switch that has left the list does not
            # count).  Only otherwise does the selected row matter, so it cannot block them.
            marked = [d for d in self.marked_devices() if valid_host(d.host)]
            if len(marked) > 1:
                return self.connect_many(marked) if command == "ssh" else self.start_batch(marked)
        dev = self.selected()
        if dev is None:
            self.message("No switch selected", error=True)
            return None
        if command == "details":
            return self.show_details(dev)
        if not valid_host(dev.host):
            self.message("'%s' has no usable IP/host ('%s')" % (dev.name, dev.host), error=True)
            return None
        if command == "ssh":
            self.connect(dev)
        elif command == "ping":
            stream = ProcStream(ping_argv(dev.host, 4, max(2, self.cfg.ping_timeout)),
                                env=dict(os.environ, LC_ALL="C"))      # predictable English output
            self.show_text("ping %s (%s)" % (dev.name, dev.host), stream=stream)
            replied = ping_replied("\n".join(stream.snapshot()))
            state = ping_verdict(replied, stream.done, stream.killed, stream.started)
            if state is None:
                return None                      # cancelled before any reply: no verdict
            self.set_status("ping", dev.host, state)
            self.save_status()
            self.status_changed(dev)
        return None

    # -- ping, several at once -----------------------------------------------

    def start_batch(self, devices):
        """ping with 2+ switches marked: check the ones you are working with, without the
        live output.  This is a reachability check on a handful of devices, not a sweep -
        watching the fleet is another tool's job."""
        if self.batch and self.batch.running and not self.batch.cancelled:
            self.message("A ping is already running (ESC with an empty search cancels it)")
            return
        if not which("ping"):
            self.message("'ping' is not installed", error=True)
            return
        hosts = list(dict.fromkeys(d.host for d in devices))     # each address once, in order
        self.batch = BatchPing(hosts, self.cfg, self.results(), self.checked)
        self.message("Pinging %d marked switches - ESC cancels" % len(hosts))

    # -- popups -------------------------------------------------------------

    def show_text(self, title, lines=None, stream=None):
        """Full screen viewer.  Lines are strings (wrapped) or lists of (text, attr)
        segments (drawn as they are).  ESC / Enter / q closes; streams are stopped."""
        scr, th, sym = self.scr, self.th, self.th.sym
        offset, follow = 0, stream is not None
        try:
            while True:
                h, w = scr.getmaxyx()
                content = stream.snapshot() if stream else lines
                rows = []
                for line in content:
                    if isinstance(line, list):
                        rows.append(line)
                    else:
                        attr = th.info if line.startswith("$ ") else th.hint if line.startswith("[finished") else th.text
                        rows += [[(part, attr)] for part in wrap_lines([line], w - 5)]
                body_h = max(1, h - 5)          # top bar, rule, blank ... rule, footer
                max_off = max(0, len(rows) - body_h)
                if follow:
                    offset = max_off
                offset = max(0, min(offset, max_off))

                scr.erase()
                right, right_attr = "", None
                if stream:
                    if not stream.done:
                        right, right_attr = sym["dot"] + " running", th.wait
                    elif stream.returncode == 0:
                        right, right_attr = sym["dot"] + " done", th.up
                    else:
                        right, right_attr = "%s exit %s" % (sym["dot"], stream.returncode), th.down
                position = ""
                if len(rows) > body_h:
                    position = "%d-%d / %d" % (offset + 1, min(len(rows), offset + body_h), len(rows))
                hints = [("ESC", "close"), (sym["ud"], "scroll"), ("PgUp PgDn", "page")]
                self.draw_frame("%s %s" % (sym["gt"], title), right, right_attr, hints, position,
                                show_message=False)
                for i, segments in enumerate(rows[offset:offset + body_h]):
                    x = 3
                    for text, attr in segments:
                        put(scr, 3 + i, x, text, attr)
                        x += len(text)
                scr.refresh()

                key = read_key(scr, 150)
                if key in ("ESC", "ENTER", "q", "Q"):
                    break
                elif key == "UP":
                    offset, follow = offset - 1, False
                elif key == "DOWN":
                    offset += 1
                    follow = stream is not None and offset >= max_off
                elif key == "PGUP":
                    offset, follow = offset - body_h, False
                elif key in ("PGDN", " "):
                    offset += body_h
                    follow = stream is not None and offset >= max_off
                elif key == "HOME":
                    offset, follow = 0, False
                elif key == "END":
                    offset, follow = max_off, stream is not None
                elif key == "RESIZE":
                    self.sync_size()
        finally:
            if stream:
                stream.stop()
            # Force a full repaint, which is what Ctrl-L does by hand.  curses otherwise
            # only sends the difference, so anything the terminal dropped or mangled on a
            # laggy link stays on screen - a ping line left over in the switch list was
            # reported from the field.  Coming back from an ssh session already clears
            # (resume_curses -> sync_size), closing a full-screen view did not.
            self.scr.clear()

    def show_details(self, dev):
        th = self.th
        last = self.state.recent.get(device_key(dev))

        def result(kind, states):
            stamp = self.checked.get((kind, dev.host))
            text = states.get(dev.host, "not checked")
            return text + ("   (%s)" % time.strftime("%Y-%m-%d %H:%M", time.localtime(stamp)) if stamp else "")
        reason = self.detail.get(("ssh", dev.host), "")
        values = list(dev.values.items()) + [
            ("Ping", result("ping", self.ping)),
            ("SSH (last try)", result("ssh", self.ssh)),
        ]
        if reason:
            # The reason is why this column exists, so it is wrapped onto its own lines
            # instead of being clipped at the right edge.
            room = max(20, self.scr.getmaxyx()[1] - 24)
            for i, line in enumerate(textwrap.wrap(reason, room)[:4]):
                values.append(("why it failed" if i == 0 else "", line))
        values += [
            ("Favourite", "yes" if device_key(dev) in self.state.favorites else "no"),
            ("Last connected", time.strftime("%Y-%m-%d %H:%M", time.localtime(last)) if last else "never"),
        ]
        width = max(len(k) for k, _ in values)
        lines = [[(k.ljust(width), th.head), ("   ", th.text), (v, th.text)] for k, v in values]
        self.show_text("details %s %s" % (self.th.sym["sep"], dev.name), lines=lines)

    def show_help(self):
        th = self.th
        lines = [[(b, getattr(th, "banner%d" % (i + 1)))] for i, b in enumerate(BANNER)]
        lines += [[], [(TITLE, th.brand), ("   v" + VERSION, th.hint)], []]
        for entry in help_sections(self.cfg, self.ncols(), len(self.devices)):
            if entry[0] == "section":
                lines += [[], [(entry[1].upper(), th.head)]]
            else:
                lines.append([("  " + entry[1].ljust(30), th.key), (entry[2], th.text)])
        lines += [[], [(CREDIT, th.brand_sub), ("  %s  Inspired by V-Li: Switch Manager (Franz, 2025)."
                                                   % self.th.sym["sep"], th.hint)]]
        self.show_text("help", lines=lines)

    # -- dialog windows -----------------------------------------------------

    def draw_window(self, title, subtitle, bh, bw):
        """Main screen slightly faded, then an empty framed window of bh x bw,
        centred, with the title in the top frame line.  Returns its top-left corner."""
        scr, th = self.scr, self.th
        tl, tr, bl, br, hl, vl = th.sym["box"]
        self.draw(refresh=False)
        h, w = scr.getmaxyx()
        for y in range(h):                       # fade what is behind the window
            try:
                scr.chgat(y, 0, w - 1 if y == h - 1 else -1, th.backdrop)
            except curses.error:
                pass
        y0, x0 = max(0, (h - bh) // 2), max(0, (w - bw) // 2)
        put(scr, y0, x0, tl + hl * (bw - 2) + tr, th.win_frame)
        for y in range(y0 + 1, y0 + bh - 1):
            put(scr, y, x0, vl + " " * (bw - 2) + vl, th.win_frame)
            put(scr, y, x0 + 1, " " * (bw - 2), th.win)
        put(scr, y0 + bh - 1, x0, bl + hl * (bw - 2) + br, th.win_frame)
        put(scr, y0, x0 + 2, " %s " % title, th.win_title)
        if subtitle:
            put(scr, y0, x0 + 4 + len(title), "%s %s " % (th.sym["sep"], subtitle), th.win_frame)
        return y0, x0

    # Settings you may want to flip in the middle of a day.  Everything else
    # (columns, paths, the password lifetime) is set once in truffle.conf and left alone.
    #   key, label, what it changes
    TOGGLES = [("l", "Session log", "session_log"),
               ("d", "Debug log", "debug"),
               ("t", "Several switches at once (tmux)", "tmux")]

    def settings(self):
        """Ctrl-G: turn the things on that you only want for the next hour.

        Ctrl-G and not Ctrl-O: ^O is the tty "discard" character (VDISCARD), which the
        terminal driver eats before curses ever sees it, because cbreak() clears ICANON
        but not IEXTEN.  ^U / ^W / ^R are ICANON-only, which is why those do arrive.

        Session-only on purpose: writing these back would rewrite truffle.conf and
        throw away its comments, and "just for now" is what this screen is for."""
        scr, th = self.scr, self.th
        while True:
            rows = []
            for key, label, option in self.TOGGLES:
                on = getattr(self.cfg, option)
                extra = ""
                if option == "session_log" and on:
                    extra = self.cfg.log_dir
                elif option == "debug" and on:
                    extra = os.path.join(self.cfg.state_dir, "debug.log")
                rows.append((key, label, "on" if on else "off", extra))
            rows.append(("c", "Screen symbols", self.cfg.charset_setting +
                         ("" if self.cfg.charset_setting != "auto" else " (%s)" % self.cfg.charset), ""))
            rows.append(("p", "Forget the stored password now",
                         "held" if self.creds else "not held", ""))
            width = min(80, max(56, scr.getmaxyx()[1] - 6))
            label_w, value_x = 34, 3 + 4 + 34 + 2
            y0, x0 = self.draw_window("Settings", "for this TRuffle only", len(rows) + 7, width)
            for i, (key, label, value, extra) in enumerate(rows):
                y = y0 + 2 + i
                put(scr, y, x0 + 3, key, th.win_key)
                put(scr, y, x0 + 7, fit(label, label_w).rstrip(), th.win_label)
                text = value if not extra else "%s  %s" % (value, extra)
                put(scr, y, x0 + value_x, fit(text, width - value_x - 3, self.th.sym["more"]).rstrip(),
                    th.win_key if value == "on" else th.win_hint)
            put(scr, y0 + len(rows) + 3, x0 + 3,
                "Not saved - put it in truffle.conf to keep it"[:width - 6], th.win_hint)
            put(scr, y0 + len(rows) + 5, x0 + 3, "ESC", th.win_key)
            put(scr, y0 + len(rows) + 5, x0 + 7, "close", th.win_hint)
            scr.refresh()

            key = read_key(scr, -1)
            if key in ("ESC", "ENTER", "q", "Q", "CTRL_G"):
                return
            if key == "RESIZE":
                self.sync_size()
                continue
            for k, label, option in self.TOGGLES:
                if key == k:
                    setattr(self.cfg, option, not getattr(self.cfg, option))
                    self.message("%s %s" % (label, "on" if getattr(self.cfg, option) else "off"))
            if key == "c":
                order = ["auto", "unicode", "ascii"]
                nxt = order[(order.index(self.cfg.charset_setting) + 1) % len(order)]
                self.cfg.charset_setting = nxt
                self.cfg.charset = detect_charset(nxt)
                self.th = Theme(self.cfg.charset)        # rebuild: symbols change at once
                self.message("Screen symbols: %s" % nxt)
            elif key == "p":
                if self.creds:
                    self.forget_creds("you asked")
                else:
                    self.message("No password is stored")

    def confirm(self, title, question, detail=()):
        """A y/n window.  Anything other than y / Enter means no."""
        width = min(72, max(40, self.scr.getmaxyx()[1] - 6))
        lines = list(textwrap.wrap(question, width - 6)) + [""] + list(detail)
        y0, x0 = self.draw_window(title, "", len(lines) + 4, width)
        for i, line in enumerate(lines):
            put(self.scr, y0 + 1 + i, x0 + 3, line[:width - 6], self.th.win_hint if i else self.th.win_label)
        put(self.scr, y0 + len(lines) + 2, x0 + 3, "y", self.th.win_key)
        put(self.scr, y0 + len(lines) + 2, x0 + 5, "yes      any other key: no", self.th.win_hint)
        self.scr.refresh()
        return read_key(self.scr, -1) in ("y", "Y")

    # -- credentials --------------------------------------------------------

    def credential_dialog(self, error=None):
        """Ask user + password.  Returns (user, password or None) or None on ESC."""
        entry = [self.last_user or "", ""]           # what is typed: username, password
        field = 1 if entry[0] else 0
        scr, th, sym = self.scr, self.th, self.th.sym
        while True:
            bw, bh = min(62, scr.getmaxyx()[1] - 6), 13
            y0, x0 = self.draw_window("Login", "asked once per session", bh, bw)
            fw = max(6, bw - 18)

            values = [entry[0], sym["mask"] * len(entry[1])]
            for i, label in enumerate(("Username", "Password")):
                y = y0 + 2 + i * 2
                active = field == i
                put(scr, y, x0 + 3, label, th.win_label if active else th.win)
                shown = values[i][-(fw - 2):]
                put(scr, y, x0 + 14, " " + shown.ljust(fw - 1), th.field if active else th.field_idle)
                if active:
                    put(scr, y, x0 + 15 + len(shown), " ", th.cursor)
            if error:
                for i, line in enumerate(textwrap.wrap(sym["dot"] + " " + error, bw - 6, subsequent_indent="  ")[:2]):
                    put(scr, y0 + 6 + i, x0 + 3, line, th.win_err)
            put(scr, y0 + 8, x0 + 3, ("Kept in memory only %s forgotten when TRuffle exits" % sym["sep"])[:bw - 6],
                th.win_hint)
            put(scr, y0 + 9, x0 + 3, "Empty password: ssh asks at every login"[:bw - 6], th.win_hint)
            x = x0 + 3
            for key, label in (("Enter", "OK"), ("Tab", "next field"), ("ESC", "cancel")):
                put(scr, y0 + 11, x, key, th.win_key)
                put(scr, y0 + 11, x + len(key) + 1, label, th.win_hint)
                x += len(key) + len(label) + 4
            scr.refresh()

            key = read_key(scr, -1)
            if key is None:
                continue
            if key == "ESC":
                return None
            if key in ("TAB", "BTAB", "UP", "DOWN"):
                field = 1 - field
            elif key == "ENTER":
                if field == 0:
                    field = 1
                    continue
                if not valid_user(entry[0]):
                    error, field = "Please enter a valid username.", 0
                    continue
                self.last_user = entry[0]
                return entry[0], (entry[1] or None)
            elif key == "BACKSPACE":
                entry[field] = entry[field][:-1]
            elif key == "CTRL_U":
                entry[field] = ""
            elif key == "RESIZE":
                self.sync_size()
            elif key == "PASTE":            # first line only: a password gets no newline
                entry[field] += paste_text(PASTE["text"], multiline=False)
                PASTE["text"] = ""
            elif len(key) == 1:
                entry[field] += key

    # -- ssh ----------------------------------------------------------------

    def connect(self, dev):
        error = None
        while True:
            if self.creds is None:
                creds = self.credential_dialog(error)
                if creds is None:
                    self.message("ssh cancelled")
                    return
                self.set_creds(creds)
            user, password = self.creds
            result = self.run_ssh(dev, user, password)
            if result.auth_failed:
                self.creds = None             # wipe the wrong password, ask again
                error = "Login failed for '%s' on %s - please re-enter." % (user, dev.name)
                continue
            reason = ssh_failure_reason(result) if result.failed or result.hostkey_changed else ""
            if result.hostkey_changed:
                self.message("%s: %s" % (dev.name, reason), error=True, seconds=15)
            elif not result.failed:
                self.state.touch(device_key(dev))
                self.message("Disconnected from %s" % dev.name)
            else:
                text = "%s: ssh exit code %d" % (dev.name, result.exit_code)
                if result.last_line:
                    text += " - " + result.last_line
                self.message(text, error=True, seconds=10)
            if result.prompt_missed:
                self.message("%s: no password prompt recognised - you had to type it yourself. "
                             "Run 'truffle --debug' and connect again to see what the switch sent."
                             % dev.name, error=True, seconds=20)
            # the SSH column remembers how your last real attempt went - no extra connections.
            # The reason is saved with it, so it survives a restart and details can show it.
            self.set_status("ssh", dev.host, SSH_FAILED if reason else SSH_OK, reason)
            self.save_status()
            self.status_changed(dev, force=True)        # is:recent, ssh: searches, status sorts
            return

    def note(self, *lines):
        return note_text(lines, self.th.colors, self.th.sym["gt"])

    def live_sessions(self):
        """Ask tmux right now - a cached list may name a session that has just ended.
        Sets sessions_foreign when the only sessions left were started by another
        TRuffle window of ours, so Ctrl-K / Ctrl-T can say so before touching them."""
        if not which("tmux"):
            self.sessions_foreign = False
            return []
        alive = set(truffle_sessions())
        self.my_sessions = [s for s in self.my_sessions if s in alive]
        self._sessions_checked = time.time()
        self.sessions_foreign = not self.my_sessions and bool(alive)
        return self.my_sessions or sorted(alive)

    def enter_tmux(self, session):
        """Hand the terminal to tmux and come back.  Returns an error text or ''."""
        self.leave_curses()
        try:
            if os.environ.get("TMUX"):      # tmux refuses to nest: switch instead of attach
                try:
                    tmux_run("switch-client", "-t", "=" + session)
                    return ""
                except (RuntimeError, OSError, subprocess.SubprocessError) as e:
                    return str(e)
            ok, error = attach_session(session)
            return "" if ok else error
        finally:
            self.resume_curses()
            self.reload_status()

    def reattach(self):
        """Ctrl-T: back into the tmux session that holds the open switches."""
        if not which("tmux"):
            self.message("tmux is not installed", error=True, seconds=10)
            return
        sessions = self.live_sessions()
        if not sessions:
            self.message("No open switch session - mark 2 or more switches with Tab, then run ssh",
                         seconds=10)
            return
        session = sessions[-1]              # the newest one
        if self.sessions_foreign and not self.confirm(
                "Go into another window's session",
                "%s was not started by this TRuffle window. Go into it anyway?" % session,
                detail=["  another TRuffle of yours is probably using it"]):
            self.message("Nothing opened")
            return
        error = self.enter_tmux(session)
        if error:
            self.message("Could not go back to %s: %s" % (session, error), error=True, seconds=15)
            return
        left = self.live_sessions()
        if os.environ.get("TMUX"):
            self.message("Switched to %s (Ctrl-b L switches back here)" % session, seconds=10)
        elif len(left) > 1:
            self.message("Back from %s - still running: %s" % (session, ", ".join(s for s in left
                                                                                 if s != session)), seconds=15)
        else:
            self.message("Back from %s" % session if session in left else "%s has ended" % session)

    def close_sessions(self):
        """Ctrl-K: close the switch sessions without hunting for a tmux key."""
        sessions = self.live_sessions()
        if not sessions:
            self.message("No open switch session", seconds=8)
            return
        detail = ["  " + s for s in sessions]
        if self.sessions_foreign:           # not ours: say so before logging anyone out
            detail += ["", "  NOT started by this TRuffle window - another", "  TRuffle of yours may be using them."]
        if not self.confirm("Close switch sessions",
                            "Close %d tmux session%s and log out of every switch in them?"
                            % (len(sessions), "" if len(sessions) == 1 else "s"), detail=detail):
            self.message("Nothing closed")
            return
        for session in sessions:
            tmux_try("kill-session", "-t", "=" + session)
        self.live_sessions()
        self.reload_status()
        self.message("Closed %d tmux session%s" % (len(sessions), "" if len(sessions) == 1 else "s"))

    def connect_many(self, devices):
        """Several switches at once: one tmux session, one pane each, one login.
        Ctrl-b d brings you back here; the sessions keep running until you log out."""
        if not self.cfg.tmux or not which("tmux"):
            self.message("%s - connecting to several switches at once needs it. "
                         "Marks still decide what ping checks; ESC (empty search) clears them to ssh one."
                         % ("tmux mode is off (tmux = yes in truffle.conf)" if not self.cfg.tmux
                            else "tmux is not installed"), error=True, seconds=12)
            return
        extra = len(devices) - MAX_PANES
        devices = devices[:MAX_PANES]
        if self.creds is None:
            creds = self.credential_dialog()
            if creds is None:
                self.message("ssh cancelled")
                return
            self.set_creds(creds)
        handover = Handover(lambda: self.creds)
        try:
            session = open_panes(self.cfg, devices, handover)
        except (RuntimeError, OSError, ValueError, subprocess.SubprocessError) as e:
            handover.close()
            self.message("tmux failed: %s" % e, error=True, seconds=15)
            return
        self.my_sessions.append(session)
        self.marked.clear()
        self.message("Starting %d panes and logging them in ..." % len(devices), seconds=30)
        self.draw()                                  # the wait is short, but never silent
        got_logins = wait_for_logins(handover)       # panes fetch immediately after they start
        handover.close()                             # the socket is not needed any more
        refused = handover.take_refusals()
        held = self.creds is not None
        error = self.enter_tmux(session)             # also reloads what the panes wrote
        self.live_sessions()
        # A pane may have reported a wrong password while we were in tmux, in which case
        # forget_creds() already said so.  That is the message that matters, so it is
        # carried into this one instead of being overwritten by it.
        lost = held and self.creds is None
        # The dropped password leads the line: a long message is cut off at the right
        # edge, and this is the part the user has to act on.
        lead = ("Password was wrong and has been dropped - you will be asked again.  %s  "
                % self.th.sym["sep"]) if lost else ""
        if error:
            self.message("%stmux session %s started, but could not show it: %s" % (lead, session, error),
                         error=True, seconds=15)
            return
        note = lead + "%d switch%s in tmux session %s" % (len(devices), "" if len(devices) == 1 else "es", session)
        if not got_logins:
            note += " - some panes had to ask for the password themselves"
        if extra > 0:
            note += " (%d more were not opened - %d panes at most)" % (extra, MAX_PANES)
        if refused:
            note += " - REFUSED: %s" % "; ".join(refused[:2])
        note += "  %s  Ctrl-b d comes back here, Ctrl-T goes back in, Ctrl-K closes them" % self.th.sym["sep"]
        self.message(note, error=bool(refused or lost), seconds=20)

    def leave_curses(self):
        """Give the plain terminal to ssh or tmux: our paste mode goes with it."""
        bracketed_paste(False)
        curses.endwin()

    def run_ssh(self, dev, user, password):
        """One session in TRuffle's own terminal: leave curses, connect, come back."""
        self.leave_curses()
        try:
            return ssh_flow(self.cfg, dev.name, dev.host, user, password, self.note)
        finally:
            self.resume_curses()

    def resume_curses(self):
        bracketed_paste(True)
        self.scr.keypad(True)
        curses.flushinp()
        self.sync_size()
        self.scr.refresh()
        self.set_cursor(False)


