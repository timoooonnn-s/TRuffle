# External commands
# --------------------------------------------------------------------------

HOST_RE = re.compile(r"^[A-Za-z0-9_.:%-]+$")


def valid_host(host):
    """Hosts come from a shared CSV: never let one look like a command line option."""
    return bool(host) and len(host) <= 253 and not host.startswith("-") and HOST_RE.match(host) is not None


@functools.lru_cache(maxsize=None)
def which(cmd):
    path = os.environ.get("PATH", os.defpath) + os.pathsep + "/usr/sbin" + os.pathsep + "/sbin"
    return shutil.which(cmd, path=path)


def ping_argv(host, count, timeout):
    wait = timeout * 1000 if sys.platform == "darwin" else timeout   # macOS: -W is in ms
    return [which("ping") or "ping", "-n", "-c", str(count), "-W", str(wait), host]


def ping_once(host, timeout):
    """One ping.  True when a real echo reply came back.

    LC_ALL=C because the reply line is parsed - on a German server the translated output
    broke the old " bytes from " test and every switch showed "down" (D17)."""
    try:
        proc = subprocess.run(ping_argv(host, 1, timeout), stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                              timeout=timeout + 5, env=dict(os.environ, LC_ALL="C"))
    except (OSError, subprocess.SubprocessError):
        return False
    return ping_replied(proc.stdout.decode("utf-8", "replace"))


def ping_verdict(replied, done, killed, started=True):
    """What a ping proved: PING_UP, PING_DOWN, or None for "no verdict, keep what we had".

    A parsed round-trip time is the ONLY proof of "up" - and it is proof whatever the exit
    code says.  Two things broke here, both of them reported from the field:
      - ESC makes TRuffle kill the ping, and a killed ping exits non-zero.  Reading that
        as "down" marked a switch unreachable with its own replies still on the screen.
      - a router answering "Destination Net Unreachable" prints a "76 bytes from ..." line
        and on macOS even exits 0, so neither that text nor the exit code means a reply
        arrived.  Only a real echo reply carries "time=", which is what ping_replied reads.
    "down" therefore needs a ping that ran to the end on its own and heard nothing.
    Anything else - cancelled early, or ping could not start - proves nothing."""
    if replied:
        return PING_UP
    if done and started and not killed:
        return PING_DOWN
    return None


def ping_replied(text):
    """True when ping's output contains a real echo reply."""
    return REPLY_RE.search(text or "") is not None


class BatchPing(object):
    """Pings the marked switches at once, one thread each.

    There is no rate limiting any more: that existed to keep a 700-switch sweep quiet
    enough for the monitoring (D20), and ping now only ever covers the handful of switches
    you marked (D35), so there is nothing left to spread out."""

    def __init__(self, hosts, cfg, status, checked):
        self.cfg, self.states, self.checked = cfg, status["ping"], checked
        self.hosts = hosts
        self.counts = {}
        self.cancelled = self.reported = False
        self.previous = {}                       # results from before, restored on cancel
        self._next = 0
        self._lock = threading.Lock()
        for host in hosts:
            if self.states.get(host) in CHECKED_STATES:
                self.previous[host] = self.states[host]
            self.states[host] = WAIT
        self.threads = [threading.Thread(target=self._work) for _ in range(min(len(hosts), 16))]
        for t in self.threads:
            t.daemon = True
            t.start()

    def _work(self):
        while True:
            with self._lock:
                if self.cancelled or self._next >= len(self.hosts):
                    return
                host = self.hosts[self._next]
                self._next += 1
            result = PING_UP if ping_once(host, self.cfg.ping_timeout) else PING_DOWN
            with self._lock:
                if self.cancelled:               # do not record a result nobody asked for
                    self._restore(host)
                    return
                self.states[host] = result
                self.checked[("ping", host)] = time.time()
                self.counts[result] = self.counts.get(result, 0) + 1

    @property
    def running(self):
        return any(t.is_alive() for t in self.threads)

    @property
    def percent(self):
        return 100 * sum(self.counts.values()) // max(1, len(self.hosts))

    def summary(self):
        return "%d up, %d down" % (self.counts.get(PING_UP, 0), self.counts.get(PING_DOWN, 0))

    def _restore(self, host):
        if self.states.get(host) == WAIT:
            if host in self.previous:
                self.states[host] = self.previous[host]
            else:
                del self.states[host]

    def cancel(self):
        with self._lock:
            self.cancelled = True
            for host in self.hosts[self._next:]:
                self._restore(host)


class ProcStream(object):
    """Runs a command in a pseudo-terminal (so its output is line buffered)
    and collects the output lines in a background thread."""

    def __init__(self, argv, env=None):
        self.lines = ["$ " + " ".join(shlex.quote(a) for a in argv), ""]
        self.partial = ""
        self.done = False
        self.returncode = None
        self.killed = False          # WE stopped it (ESC), so its exit code means nothing
        self.started = True          # False when the command could not be run at all
        self.proc = None
        self._lock = threading.Lock()
        master = slave = None
        try:
            master, slave = pty.openpty()
            self.proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=slave, stderr=slave,
                                         start_new_session=True, env=env)
        except OSError as e:
            for fd in (master, slave):
                if fd is not None:
                    os.close(fd)
            self.lines.append("cannot run %s: %s" % (argv[0], e.strerror or e))
            self.returncode, self.done, self.started = 127, True, False
            return
        os.close(slave)
        self._master = master
        t = threading.Thread(target=self._reader)
        t.daemon = True
        t.start()

    def _reader(self):
        decoder = codecs.getincrementaldecoder("utf-8")("replace")
        while True:
            try:
                data = os.read(self._master, 4096)
            except OSError:
                break
            if not data:
                break
            self._feed(decoder.decode(data))
        os.close(self._master)
        rc = self.proc.wait()
        with self._lock:
            if self.partial:
                self.lines.append(self.partial)
                self.partial = ""
            self.lines += ["", "[finished, exit code %d]" % rc]
            self.returncode = rc
            self.done = True

    def _feed(self, text):
        with self._lock:
            parts = (self.partial + text.replace("\r\n", "\n")).split("\n")
            self.partial = parts.pop()
            for line in parts:
                # keep only what a terminal would show after a carriage return
                self.lines.append(CONTROL_CHARS.sub(" ", line.split("\r")[-1]).rstrip())

    def snapshot(self):
        with self._lock:
            return self.lines + ([self.partial] if self.partial else [])

    def stop(self):
        if self.proc is not None and self.proc.poll() is None:
            self.killed = True
            for sig in (signal.SIGTERM, signal.SIGKILL):
                try:
                    os.killpg(self.proc.pid, sig)
                    self.proc.wait(timeout=1)
                    break
                except (OSError, subprocess.TimeoutExpired):
                    pass


# --------------------------------------------------------------------------
# Interactive SSH session in a pseudo-terminal
# --------------------------------------------------------------------------

PASSWORD_PROMPT = re.compile(r"password[^\r\n]*:\s*$", re.IGNORECASE)
OFFENDING_KEY = re.compile(r"Offending \S+ key in (.+):\d+\s*$", re.MULTILINE)
# Last lines that mean "ssh could not (or no longer) talk to the switch", as opposed
# to a normal logout ("Connection to x closed by remote host.").
SSH_FAILURE = re.compile(r"Permission denied|Connection (timed out|refused|reset)|No route to host|"
                         r"Could not resolve|Name or service not known|Network is unreachable|"
                         r"Host key verification failed|no matching|Too many authentication failures|"
                         r"not responding|Broken pipe|cannot run", re.IGNORECASE)
ANSI_ESCAPES = re.compile(rb"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07]*\x07|\x1b[()][0-9A-Za-z]|\x1b[=>78]|\r")


def is_password_prompt(line):
    """True for 'Password:' / "user@host's password:", never for key passphrases."""
    return PASSWORD_PROMPT.search(line) is not None and "passphrase" not in line.lower()


def build_ssh_argv(cfg, user, host, inject_password):
    # ssh uses the FIRST value it sees for an option: user options go first so they win.
    argv = list(cfg.ssh_command) + list(cfg.ssh_options)
    argv += ["-o", "StrictHostKeyChecking=accept-new",
             "-o", "ConnectTimeout=%d" % cfg.connect_timeout,
             "-o", "ServerAliveInterval=15",
             "-o", "ServerAliveCountMax=3"]
    if inject_password:
        # One try only: a wrong password must never be repeated (account lockout).
        argv += ["-o", "NumberOfPasswordPrompts=1"]
    if user:
        argv += ["-l", user]
    return argv + ["--", host]


class SessionResult(object):
    def __init__(self):
        self.exit_code = None
        self.password_sent = False
        self.auth_failed = False
        self.hostkey_changed = False
        self.user_typed = False      # the user typed something, so output after that is the session
        self.known_hosts = None      # file named in ssh's "Offending ... key in FILE:N"
        self.last_line = ""
        self.wanted_password = False  # a password was stored for this attempt
        self.events = []             # what happened around the login, for --debug
        self.pre_login = ""          # output before the user's first keystroke (no secrets)

    @property
    def prompt_missed(self):
        """A password was stored and the switch answered, but no password prompt was
        recognised - so the user had to type it.  Never set when the connection itself
        failed (timeout, refused), because then no prompt could appear at all."""
        if not self.wanted_password or self.password_sent or self.hostkey_changed:
            return False
        return self.user_typed or self.exit_code == 0

    @property
    def failed(self):
        """ssh could not connect / log in, or the session died - not a normal logout."""
        if self.exit_code == 0:
            return False
        return not self.user_typed or SSH_FAILURE.search(self.last_line) is not None


def _write_all(fd, data):
    while data:
        try:
            n = os.write(fd, data)
        except OSError as e:
            if e.errno == errno.EAGAIN:
                select.select([], [fd], [], 1.0)
                continue
            raise
        data = data[n:]


def _copy_winsize(src_fd, dst_fd):
    try:
        fcntl.ioctl(dst_fd, termios.TIOCSWINSZ, fcntl.ioctl(src_fd, termios.TIOCGWINSZ, b"\0" * 8))
    except OSError:
        pass


def _exit_code(status):
    if os.WIFEXITED(status):
        return os.WEXITSTATUS(status)
    if os.WIFSIGNALED(status):
        return 128 + os.WTERMSIG(status)
    return 255


def _reap(pid, grace=2.0):
    """Wait for the child; escalate to SIGTERM / SIGKILL if it does not go away."""
    deadline = time.time() + grace
    for sig in (None, signal.SIGTERM, signal.SIGKILL):
        if sig is not None:
            try:
                os.kill(pid, sig)
            except OSError:
                pass
            deadline = time.time() + grace
        while time.time() < deadline:
            try:
                wpid, status = os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                return 255
            if wpid:
                return _exit_code(status)
            time.sleep(0.05)
    return 255


def run_session(argv, password=None, log=None, in_fd=None, out_fd=None):
    """Run argv (ssh) in a pseudo-terminal connected to our terminal.

    If a password is given it is typed once, at the first password prompt,
    as long as the user has not typed anything yet.  A second password prompt
    means the login failed: the session is aborted instead of retrying.
    Login problems (wrong password, changed host key) are only detected in the
    output before the user's first keystroke, never in the session itself."""
    in_fd = sys.stdin.fileno() if in_fd is None else in_fd
    out_fd = sys.stdout.fileno() if out_fd is None else out_fd
    result = SessionResult()
    result.wanted_password = bool(password)
    try:
        termios.tcflush(in_fd, termios.TCIFLUSH)    # drop typeahead, e.g. a double Enter
    except termios.error:
        pass
    try:
        winsize = fcntl.ioctl(in_fd, termios.TIOCGWINSZ, b"\0" * 8)
    except OSError:
        winsize = None

    pid, master = pty.fork()
    if pid == 0:   # child: becomes ssh
        try:
            signal.signal(signal.SIGPIPE, signal.SIG_DFL)
            if winsize:
                fcntl.ioctl(0, termios.TIOCSWINSZ, winsize)
            os.execvp(argv[0], argv)
        except BaseException as e:
            try:
                os.write(2, ("TRuffle: cannot run %s: %s\r\n" % (argv[0], e)).encode())
            except Exception:
                pass
        os._exit(127)

    old_attrs = None
    try:
        old_attrs = termios.tcgetattr(in_fd)
        tty.setraw(in_fd)
    except termios.error:
        pass
    old_winch = signal.signal(signal.SIGWINCH, lambda signum, frame: _copy_winsize(in_fd, master))
    decoder = codecs.getincrementaldecoder("utf-8")("replace")
    armed = bool(password)       # watching for the password prompt
    tail = captured = before_input = ""
    exit_code = None
    try:
        while True:
            ready = select.select([master, in_fd], [], [], 1.0)[0]
            if master in ready:
                try:
                    data = os.read(master, 65536)
                except OSError as e:
                    if e.errno in (errno.EIO, errno.EBADF):
                        break          # Linux: slave side closed, ssh is gone
                    raise
                if not data:
                    break
                _write_all(out_fd, data)
                if log is not None:
                    try:
                        log.write(ANSI_ESCAPES.sub(b"", data))
                        log.flush()
                    except OSError:
                        log = None
                text = decoder.decode(data)
                captured = (captured + text)[-16384:]
                if not result.user_typed:
                    before_input = (before_input + text)[-16384:]
                if armed:
                    tail = (tail + text)[-1024:]
                    last = re.split(r"[\r\n]", tail)[-1]
                    if is_password_prompt(last):
                        tail = ""
                        result.events.append("password prompt seen: %r" % last.strip())
                        if result.password_sent:
                            result.events.append("second password prompt -> wrong password, ssh stopped")
                            result.auth_failed = True
                            armed = False
                            try:
                                os.kill(pid, signal.SIGTERM)
                            except OSError:
                                pass
                        else:
                            _write_all(master, password.encode("utf-8") + b"\r")
                            result.password_sent = True
                            result.events.append("password typed (once)")
            if in_fd in ready:
                try:
                    data = os.read(in_fd, 4096)
                except OSError:
                    data = b""
                if not data:           # our own terminal is gone
                    break
                if armed:
                    result.events.append("you typed -> TRuffle stops watching for prompts" if result.password_sent
                                         else "you typed before any password prompt -> TRuffle will not type it")
                armed = False          # the user took over: never type the password again
                result.user_typed = True
                try:
                    _write_all(master, data)
                except OSError:
                    pass
            if not ready:
                # ssh may have exited while something else keeps the pty open (ControlPersist).
                try:
                    wpid, status = os.waitpid(pid, os.WNOHANG)
                except ChildProcessError:
                    wpid, status = pid, 255 << 8
                if wpid:
                    exit_code = _exit_code(status)
                    break
    finally:
        signal.signal(signal.SIGWINCH, old_winch)
        if old_attrs is not None:
            termios.tcsetattr(in_fd, termios.TCSADRAIN, old_attrs)
        if exit_code is None:
            exit_code = _reap(pid)
        os.close(master)

    result.exit_code = exit_code
    if result.password_sent and exit_code == 255 and "Permission denied" in before_input:
        result.auth_failed = True
    result.hostkey_changed = "REMOTE HOST IDENTIFICATION HAS CHANGED" in before_input
    m = OFFENDING_KEY.search(before_input.replace("\r", ""))
    if m:
        result.known_hosts = m.group(1).strip()
    result.last_line = clean_output(captured).strip().split("\n")[-1].strip()
    result.pre_login = clean_output(before_input)
    return result


def clean_output(text):
    """Terminal output as plain text lines (escape sequences and control characters removed)."""
    text = ANSI_ESCAPES.sub(b"", text.encode("utf-8", "replace")).decode("utf-8", "replace")
    return "\n".join(CONTROL_CHARS.sub(" ", line).rstrip() for line in text.split("\n"))


def remove_host_key(host, known_hosts):
    """ssh-keygen -R; returns (removed, output).  ssh-keygen exits 0 even when
    the host was not in the file, so that case is detected from its output."""
    try:
        proc = subprocess.Popen(["ssh-keygen", "-R", host, "-f", known_hosts], stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        output = proc.communicate()[0].decode("utf-8", "replace").strip()
    except OSError as e:
        return False, "cannot run ssh-keygen: %s" % e
    if proc.returncode != 0 or "not found" in output:
        return False, output or "ssh-keygen exit code %d" % proc.returncode
    return True, output


def note_text(lines, colors=True, gt=">"):
    """'TRuffle > first line', further lines indented - printed outside curses."""
    prefix = "\033[1;34mTRuffle\033[0m" if colors else "TRuffle"
    return "\r\n%s %s %s" % (prefix, gt, ("\r\n" + " " * 10).join(lines))


def open_session_log(cfg, name, host, user):
    """--log: a new 0600 log file for one session.  Returns (file or None, error or None)."""
    try:
        os.makedirs(cfg.log_dir, mode=0o700, exist_ok=True)
        safe = re.sub(r"[^A-Za-z0-9_.-]", "_", name or host)[:60]
        path = os.path.join(cfg.log_dir, "%s_%s.log" % (time.strftime("%Y%m%d-%H%M%S"), safe))
        f = os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600), "ab")
        f.write(("# TRuffle session log: %s (%s) as %s, %s\n"
                 % (name, host, user, time.strftime("%Y-%m-%d %H:%M:%S"))).encode("utf-8"))
        return f, None
    except OSError as e:
        return None, "cannot write session log: %s" % e


def write_debug_report(cfg, name, host, argv, password, result):
    """--debug: append what happened around this login to debug.log (0600): the ssh
    command, prompts, decisions and the output BEFORE the login - never the password,
    never the session itself.  Returns an error text or None."""
    lines = [
        "=== %s  %s (%s)" % (time.strftime("%Y-%m-%d %H:%M:%S"), name, host),
        "command      : %s" % " ".join(shlex.quote(a) for a in argv),
        "password     : %s" % ("stored, TRuffle types it" if password else "none stored, you type it"),
    ] + ["event        : %s" % e for e in result.events] + [
        "exit code    : %s   failed: %s   auth failed: %s   host key changed: %s" % (
            result.exit_code, result.failed, result.auth_failed, result.hostkey_changed),
        "last line    : %s" % result.last_line,
        "before login :",
    ] + ["  | " + line for line in result.pre_login.strip("\n").split("\n")[-40:]] + [""]
    path = os.path.join(cfg.state_dir, "debug.log")
    try:
        os.makedirs(cfg.state_dir, mode=0o700, exist_ok=True)
        with os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600), "a", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
        return None
    except OSError as e:
        return "cannot write %s: %s" % (path, e.strerror or e)


def ssh_failure_reason(result):
    """Why a ssh attempt failed, short enough for a column and useful in a report:
    "Connection timed out" is a different ticket from "Permission denied", which is a
    different ticket from "no matching key exchange method"."""
    if result.hostkey_changed:
        return "host key changed - not connected"
    if result.auth_failed:
        return "login refused (wrong password?)"
    line = result.last_line                      # already cleaned by run_session
    m = SSH_FAILURE.search(line)
    if m:
        return "%s (exit %s)" % (line[max(0, m.start() - 40):][:120].strip(), result.exit_code)
    if line:
        return "%s (exit %s)" % (line[:120], result.exit_code)
    return "exit code %s" % result.exit_code


def ssh_flow(cfg, name, host, user, password, note, back="return to TRuffle"):
    """One ssh connection outside curses - used by the main screen and by tmux panes.
    Connects (typing the password once), offers to replace a changed host key, and waits
    for a key after a failure so the reason stays readable.  Returns a SessionResult."""
    out = sys.stdout.fileno()

    def say(*lines):
        os.write(out, note(*lines).encode("utf-8", "replace"))
    key_removed = False
    while True:
        argv = build_ssh_argv(cfg, user, host, inject_password=bool(password))
        say("Connecting to %s (%s) as %s" % (name, host, user),
            "log out to %s, ~. force-disconnects" % back)
        os.write(out, b"\r\n\r\n")
        log = None
        if cfg.session_log:
            log, error = open_session_log(cfg, name, host, user)
            if error:
                say(error)
        try:
            result = run_session(argv, password, log)
        finally:
            if log is not None:
                log.close()
        if cfg.debug:
            error = write_debug_report(cfg, name, host, argv, password, result)
            if error:
                say(error)
        if result.hostkey_changed and not result.auth_failed:
            known_hosts = result.known_hosts or os.path.join(os.path.expanduser("~"), ".ssh", "known_hosts")
            if key_removed:
                terminal_wait_key(note("The host key is still reported as changed.",
                                       "Please check %s by hand." % known_hosts,
                                       "Press any key to %s ..." % back))
                return result
            answer = terminal_wait_key(note(
                "The host key of %s (%s) has CHANGED." % (name, host),
                "Expected if the switch was replaced - otherwise do NOT continue.",
                "Remove the old key from %s and connect again? [y/N] " % known_hosts))
            if answer not in (b"y", b"Y"):
                return result
            ok, text = remove_host_key(host, known_hosts)
            os.write(out, (text.replace("\n", "\r\n") + "\r\n").encode("utf-8", "replace"))
            if not ok:
                terminal_wait_key(note("Could not remove the old key.", "Press any key to %s ..." % back))
                return result
            key_removed = True
            continue
        if result.failed and not result.auth_failed:
            terminal_wait_key(note("Connection to %s ended (exit code %d)." % (name, result.exit_code),
                                   "Press any key to %s ..." % back))
        return result


# --------------------------------------------------------------------------
# Several switches at once: one tmux session, one pane per switch.
#
# The panes are started by tmux, not by TRuffle, so their command line is visible
# to every user on the machine (ps) and must not carry the password.  Each pane
# gets a one-time ticket instead and fetches the login through a Unix socket that
# lives in a private 0700 directory.  Before answering, TRuffle asks the kernel
# who is on the other end and only replies to our own user and to the exact
# process tmux started for that ticket.  Linux and macOS.
# --------------------------------------------------------------------------

MAX_PANES = 9
SESSION_PREFIX = "truffle-"
TICKET_LIFETIME = 15                     # seconds: a pane fetches its login immediately


def tmux_run(*args):
    """Run a tmux command.  Returns its stripped output; raises RuntimeError on failure."""
    proc = subprocess.run(["tmux"] + list(args), stdin=subprocess.DEVNULL,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=10)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.decode("utf-8", "replace").strip() or "tmux failed")
    return proc.stdout.decode("utf-8", "replace").strip()


def tmux_try(*args):
    """Best effort: cosmetic tmux settings must not break the feature on an old tmux."""
    try:
        tmux_run(*args)
    except (RuntimeError, OSError, subprocess.SubprocessError):
        pass


def truffle_sessions():
    """Our tmux sessions that are still alive, oldest first."""
    try:
        lines = tmux_run("list-sessions", "-F", "#{session_created} #{session_name}").splitlines()
    except (RuntimeError, OSError, subprocess.SubprocessError):
        return []
    names = [line.split(" ", 1)[1] for line in sorted(lines) if " " in line]
    return [n for n in names if n.startswith(SESSION_PREFIX)]


def peer_identity(conn):
    """(uid, pid) of the process on the other end of a Unix socket, straight from the
    kernel - a connecting process cannot fake either.  Returns (None, None) if the
    platform does not support it, and the caller then refuses."""
    try:
        if sys.platform.startswith("linux"):
            pid, uid, _ = struct.unpack("3i", conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                                              struct.calcsize("3i")))
            return uid, pid
        if sys.platform == "darwin":
            sol_local, peercred, peerpid = 0, 0x001, 0x002
            xucred = conn.getsockopt(sol_local, peercred, 100)        # version, uid, ...
            uid = struct.unpack("2I", xucred[:8])[1]
            pid = struct.unpack("i", conn.getsockopt(sol_local, peerpid, 4))[0]
            return uid, pid
    except (OSError, struct.error):
        pass
    return None, None


def parent_pid(pid):
    """The parent of pid, or None.  Used because some shells do not exec the pane
    command, which would make the connecting process a child of tmux's pane process."""
    try:
        if sys.platform.startswith("linux"):
            with open("/proc/%d/stat" % pid, encoding="utf-8", errors="replace") as f:
                return int(f.read().rsplit(")", 1)[1].split()[1])
        out = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, timeout=5).stdout
        return int(out.strip() or 0) or None
    except (OSError, ValueError, IndexError, subprocess.SubprocessError):
        return None


class Handover(object):
    """Hands the login to tmux panes, once per pane.

    A ticket is only answered when the connecting process runs as our user AND is the
    process tmux started for that ticket, the ticket is unused, and it is younger than
    TICKET_LIFETIME.  The socket itself sits in a directory only we can open."""

    def __init__(self, credentials):
        self.credentials = credentials        # callable -> (user, password or None)
        self.dir = tempfile.mkdtemp(prefix="truffle-", dir=os.environ.get("XDG_RUNTIME_DIR") or None)
        self.path = os.path.join(self.dir, "handover.sock")
        self.server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        old = os.umask(0o177)
        try:
            self.server.bind(self.path)       # 0600, inside a 0700 directory
        finally:
            os.umask(old)
        self.server.listen(MAX_PANES + 2)
        self.tickets = {}                     # ticket -> {host, pid, created, fetched}
        self.refused = []                     # connections we turned away, shown to the user
        self.lock = threading.Lock()
        self.closed = False
        t = threading.Thread(target=self._serve)
        t.daemon = True
        t.start()

    def issue(self, host):
        """A ticket for one pane.  bind() must follow once tmux reports the pane's pid."""
        ticket = secrets.token_hex(16)
        with self.lock:
            self.tickets[ticket] = {"host": host, "pid": None, "created": time.time(), "fetched": False}
        return ticket

    def bind(self, ticket, pid):
        with self.lock:
            if ticket in self.tickets:
                self.tickets[ticket]["pid"] = pid

    def _serve(self):
        while True:
            try:
                conn, _ = self.server.accept()
            except OSError:
                return                        # closed
            # one thread per connection: a client that connects and then says nothing
            # must not keep the other panes waiting for their login
            worker = threading.Thread(target=self._client, args=(conn,))
            worker.daemon = True
            worker.start()

    def _client(self, conn):
        with conn:
            try:
                conn.settimeout(3)
                conn.sendall(self._handle(conn).encode("utf-8") + b"\n")
            except (OSError, ValueError, struct.error):
                pass

    def _handle(self, conn):
        uid, pid = peer_identity(conn)
        if uid is None or uid != os.getuid():
            with self.lock:
                self.refused.append("connection from uid %s" % uid)
            return "ERR refused"
        request = conn.recv(4096).decode("utf-8", "replace").strip()
        kind, _, ticket = request.partition(" ")
        ticket = ticket.strip()
        if kind != "GET":
            return "ERR refused"
        with self.lock:
            entry = self.tickets.get(ticket)
            if entry is None:
                return "ERR unknown ticket"
            if entry["fetched"]:
                self.refused.append("ticket for %s used twice" % entry["host"])
                return "ERR already used"
            if time.time() - entry["created"] > TICKET_LIFETIME:
                return "ERR ticket expired"
            expected, host = entry["pid"], entry["host"]
        # An unbound ticket (tmux has not reported the pane's pid yet) is simply refused.
        # The pane then asks for the password itself - a rare, harmless fallback, and far
        # better than waiting here and widening the window in which anything may ask.
        # Looking up a parent pid runs `ps` on macOS, so it happens outside the lock -
        # otherwise one slow lookup would hold up every other pane.
        if pid != expected and parent_pid(pid) != expected:    # ps only when it is needed
            with self.lock:
                self.refused.append("pid %s is not the pane for %s" % (pid, host))
            return "ERR wrong process"
        with self.lock:
            entry = self.tickets.get(ticket)
            if entry is None or entry["fetched"]:     # checked again: single use must be exact
                return "ERR already used"
            entry["fetched"] = True
            user, password = self.credentials()
        return "OK " + json.dumps({"user": user, "password": password or ""})

    @property
    def pending(self):
        with self.lock:
            return any(not e["fetched"] for e in self.tickets.values())

    def take_refusals(self):
        with self.lock:
            refused, self.refused = self.refused, []
        return refused

    def close(self):
        """Stop listening and remove the socket; panes that still hold a ticket can no
        longer fetch a login (they ask the user instead) and cannot report back."""
        if self.closed:
            return
        self.closed = True
        try:
            self.server.close()
        except OSError:
            pass
        shutil.rmtree(self.dir, ignore_errors=True)      # the socket and its 0700 directory


def handover_request(path, line):
    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    conn.settimeout(5)
    try:
        conn.connect(path)
        conn.sendall(line.encode("utf-8") + b"\n")
        answer = b""
        while not answer.endswith(b"\n") and len(answer) < 65536:
            chunk = conn.recv(4096)
            if not chunk:
                break
            answer += chunk
        return answer.decode("utf-8", "replace").strip()
    finally:
        conn.close()


def pane_main(cfg, socket_path, ticket, host, name):
    """`truffle --pane ...` runs inside one tmux pane: fetch the login once, connect,
    report back, then the pane closes."""
    colors = os.environ.get("TERM", "dumb") not in ("", "dumb")
    gt = CHARSETS[detect_charset(cfg.charset_setting)]["gt"]

    def note(*lines):
        return note_text(lines, colors, gt)
    if not valid_host(host):
        terminal_wait_key(note("'%s' is not a usable host." % host, "Press any key to close this pane ..."))
        return 1
    user, password = cfg.user, None
    try:
        answer = handover_request(socket_path, "GET %s" % ticket)
        if not answer.startswith("OK "):
            raise ValueError(answer)
        login = json.loads(answer[3:])
        user, password = login["user"], login["password"] or None
    except (OSError, ValueError, KeyError) as e:
        os.write(sys.stdout.fileno(), note(
            "Could not get the login from TRuffle (%s)." % e,
            "Connecting anyway - ssh will ask you for the password.").encode("utf-8", "replace"))
    result = ssh_flow(cfg, name, host, user, password, note, back="close this pane")
    password = login = answer = None          # every copy of the login this pane holds
    failed = result.failed or result.hostkey_changed
    state = SSH_FAILED if failed else SSH_OK
    # The status file is shared and merges by time, so the pane records its own result
    # AND why it failed; TRuffle picks both up when it comes back, however long this ran.
    user_state = UserState(cfg.state_dir)
    user_state.save_status({"ping": {}, "ssh": {host: state}}, {("ssh", host): time.time()},
                           {("ssh", host): ssh_failure_reason(result) if failed else ""})
    if state == SSH_OK:
        user_state.touch(name or host)
    if result.auth_failed:
        # Tell TRuffle too, so it drops the password instead of spending it on the
        # next switch as well - the socket is already closed by now.
        user_state.note_auth_failure(host)
        terminal_wait_key(note("Login failed on %s - wrong password?" % name,
                               "TRuffle will ask for the password again.",
                               "Press any key to close this pane ..."))
    if result.prompt_missed:
        terminal_wait_key(note("No password prompt recognised on %s - you had to type it." % name,
                               "Run TRuffle with --debug and connect again to see what the switch sent.",
                               "Press any key to close this pane ..."))
    return 0


# tmux starts panes from the tmux SERVER's environment, which can differ from ours
# (a server started earlier, or with another HOME).  These decide where TRuffle reads
# its config and writes favourites, results and logs, so they are passed on explicitly.
PANE_ENV = ("HOME", "PATH", "LANG", "LC_ALL", "LC_CTYPE", "TMPDIR",
            "XDG_CONFIG_HOME", "XDG_STATE_HOME", "XDG_RUNTIME_DIR")


def pane_command(cfg, socket_path, ticket, host, name):
    argv = ["env"] + ["%s=%s" % (k, os.environ[k]) for k in PANE_ENV if os.environ.get(k)]
    argv += [sys.executable, os.path.realpath(os.path.abspath(__file__))]
    if cfg.config_file:
        argv += ["--config", cfg.config_file]
    if cfg.debug:
        argv += ["--debug"]
    if cfg.session_log:
        argv += ["--log"]
    if cfg.charset_setting == "ascii":
        argv += ["--ascii"]              # --ascii was a flag, not a config value: pass it on
    argv += ["--pane", socket_path, ticket, host, name]
    return " ".join(shlex.quote(a) for a in argv)


def open_panes(cfg, devices, handover):
    """Create a tmux session with one pane per switch and return its name."""
    session = free_session_name()
    first, rest = devices[0], devices[1:]

    def start(dev, *extra):
        ticket = handover.issue(dev.host)
        command = pane_command(cfg, handover.path, ticket, dev.host, dev.name)
        out = tmux_run(*(list(extra) + ["-P", "-F", "#{pane_pid} #{pane_id}", command]))
        pid, _, pane_id = out.strip().partition(" ")
        handover.bind(ticket, int(pid or 0))
        tmux_try("select-pane", "-t", pane_id, "-T", "%s (%s)" % (dev.name, dev.host))

    size = terminal_size() or (24, 80)          # a detached session would default to 80x24
    try:
        start(first, "new-session", "-d", "-s", session, "-x", str(size[1]), "-y", str(size[0]))
        for dev in rest:
            start(dev, "split-window", "-t", session)
            tmux_try("select-layout", "-t", session, "tiled")
    except BaseException:
        tmux_try("kill-session", "-t", "=" + session)       # never leave half a session behind
        raise
    tmux_try("set-window-option", "-t", session, "synchronize-panes", "off")   # never type into all
    tmux_try("set-window-option", "-t", session, "pane-border-status", "top")
    tmux_try("set-window-option", "-t", session, "pane-border-format", " #{pane_title} ")
    tmux_try("set-option", "-t", session, "status-left", "[TRuffle]  ")
    tmux_try("set-option", "-t", session, "status-right",
             " Ctrl-b d = back to TRuffle   Ctrl-b o = next pane   exit = leave one switch ")
    tmux_try("set-option", "-t", session, "status-right-length", "80")
    return session


def wait_for_logins(handover, deadline=TICKET_LIFETIME):
    """Give the panes their short window to fetch the login.  Returns True if all of
    them did; after this the socket is no longer needed for logins."""
    end = time.time() + deadline
    while handover.pending and time.time() < end:
        time.sleep(0.05)
    return not handover.pending


def session_exists(session):
    try:
        tmux_run("has-session", "-t", "=" + session)
        return True
    except (RuntimeError, OSError, subprocess.SubprocessError):
        return False


def free_session_name():
    """truffle-HHMMSS, with a suffix if that name is taken - two multi-ssh actions in
    the same second would otherwise collide."""
    base = SESSION_PREFIX + time.strftime("%H%M%S")
    name, n = base, 1
    while session_exists(name) and n < 100:
        name, n = "%s-%d" % (base, n), n + 1
    return name


def attach_session(session):
    """Hand the terminal to tmux until the user detaches (Ctrl-b d) or the session ends.
    Returns (ok, message) - a failed attach must not look like nothing happened."""
    if not session_exists(session):
        return False, "the tmux session %s is gone" % session
    try:
        code = subprocess.call(["tmux", "attach-session", "-t", "=" + session])
        return code == 0, "" if code == 0 else "tmux attach ended with code %d" % code
    except (OSError, subprocess.SubprocessError) as e:
        return False, "cannot run tmux: %s" % e


def harden_process():
    """The password lives in this process's memory, so keep that memory to ourselves:
    - no core dumps: a crash must not write the password into a file on disk
    - Linux: not "dumpable" - other processes of the same user can no longer attach
      to TRuffle or read /proc/<pid>/mem (root still can, as with every program).
      ssh and ping started by TRuffle are not affected (exec resets this)."""
    try:
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    except (ValueError, OSError):
        pass
    if sys.platform.startswith("linux"):
        try:
            import ctypes
            libc = ctypes.CDLL(None, use_errno=True)
            libc.prctl(4, 0, 0, 0, 0)          # PR_SET_DUMPABLE = 4, value 0
        except (OSError, AttributeError):
            pass


def terminal_size():
    try:
        rows, cols = struct.unpack("hhhh", fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8))[:2]
        if rows > 0 and cols > 0:
            return rows, cols
    except OSError:
        pass
    return None


def bracketed_paste(on):
    """Ask the terminal to wrap pasted text in ESC[200~ ... ESC[201~.  A terminal that
    does not know the mode ignores it and simply never sends the markers, so behaviour
    is unchanged there - this can never make anything worse.  Must be switched off
    before the terminal is handed to ssh or tmux, and on again afterwards."""
    try:
        os.write(sys.stdout.fileno(), PASTE_ON if on else PASTE_OFF)
    except OSError:
        pass


def terminal_wait_key(prompt):
    """Outside of curses: print prompt, return one key press (bytes)."""
    os.write(sys.stdout.fileno(), prompt.encode("utf-8", "replace"))
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        termios.tcflush(fd, termios.TCIFLUSH)
        ch = os.read(fd, 1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    os.write(sys.stdout.fileno(), b"\r\n")
    return ch


